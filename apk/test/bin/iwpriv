#!/usr/bin/env python3
# mt_wifi iwpriv mock.
#   iwpriv apcli0 set Key=Value     station keys kept in /tmp/mock/apcli.json;
#                                   ApCliEnable=1 makes netsim join with them
#   iwpriv ra0|rax0 set SiteSurvey=1 / get_site_survey
#                                   driver survey table, filled 3 s after the
#                                   trigger (like the real 5 GHz survey)
import json, os, subprocess, sys, time
a = sys.argv[1:]
with open('/tmp/mock/calls.log', 'a') as f: f.write('iwpriv %s\n' % ' '.join(a))
if len(a) >= 3 and a[1] == 'set' and a[0].startswith('apcli') and '=' in a[2]:
    k, v = a[2].split('=', 1)
    p = '/tmp/mock/apcli.json'
    st = json.load(open(p)) if os.path.exists(p) else {}
    st.setdefault(a[0], {})[k] = v
    json.dump(st, open(p, 'w'))
    if k == 'ApCliEnable':
        subprocess.run([os.environ['WFT'] + '/netsim.py', 'iwpriv ' + a[2]])
elif len(a) >= 3 and a[1] == 'set' and a[2].startswith('SiteSurvey'):
    open('/tmp/mock/survey-%s' % a[0], 'w').write(str(time.time()))
elif len(a) >= 2 and a[1] == 'get_site_survey':
    band = '5g' if a[0] == 'rax0' else '2g'
    try: t0 = float(open('/tmp/mock/survey-%s' % a[0]).read())
    except Exception: t0 = 0
    w = json.load(open('/tmp/mock/world.json'))
    print('%-10sget_site_survey:' % a[0])
    print('No  Ch  SSID                             BSSID               Security               Siganl(%%)W-Mode  ExtCH  NT WPS DPID BcnRept')
    if t0 and time.time() - t0 >= 3:
        SEC = {'none': 'NONE', 'psk2': 'WPA2PSK/AES', 'psk': 'WPAPSK/TKIP', 'sae': 'WPA3PSK/AES', 'mixed': 'WPA2PSKWPA3PSK/AES', 'eap': 'WPA2/AES'}
        for i, ap in enumerate(x for x in w['aps'] if x['band'] == band):
            pct = max(0, min(100, (ap['signal'] + 100) * 2))
            print('%-4d%-4d%-33s%-20s%-23s%-9d%-7s%-7s%-3s%-4s%-5s%s' % (i, ap['channel'], ap['ssid'], ap['bssid'].lower(), SEC[ap['enc']], pct, '11a/n/ac' if band == '5g' else '11b/g/n', 'NONE', 'In', 'NO', '', 'NO'))
