#!/usr/bin/env python3
# Probe URLs answer from the mock world; everything else goes to the real curl.
import json, os, subprocess, sys
a = sys.argv[1:]
url = a[-1]
if 'connectivitycheck' in url or 'detectportal' in url:
    dev = None
    if '--interface' in a: dev = a[a.index('--interface') + 1]
    else:
        r = subprocess.run(['ip', 'route', 'get', '1.1.1.1'], capture_output=True, text=True).stdout
        p = r.split()
        dev = p[p.index('dev') + 1] if 'dev' in p else None
    inet = json.load(open('/tmp/mock/world.json')).get('inet', {})
    ok = bool(dev) and inet.get(dev, False)
    with open('/tmp/mock/calls.log', 'a') as f: f.write('probe %s %s\n' % (dev, ok))
    if 'generate_204' in url:
        sys.stdout.write('204' if ok else '000'); sys.exit(0 if ok else 7)
    sys.stdout.write('success\n' if ok else ''); sys.exit(0 if ok else 7)
os.execv(os.environ.get("REAL_CURL", "/usr/bin/curl"), ['curl', '--noproxy', '*'] + a)
