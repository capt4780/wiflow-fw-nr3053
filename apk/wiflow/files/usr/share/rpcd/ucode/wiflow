// ubus object "wiflow" for the Wiflow pages in LuCI (luci-app-wiflow ACL).
// Quick calls answer directly; joining a WiFi, renaming the guest WiFi and
// account changes run as a background job followed through status().job.
'use strict';

import * as W from 'wiflow.setup';

function str(v) {
	return type(v) == 'string' ? v : '';
}

const methods = {
	status: {
		call: function() {
			return W.status();
		}
	},

	// Scanning takes several seconds and needs rpcd's own iwinfo object, so
	// it runs as a job; the networks arrive in status().job.networks.
	scan: {
		args: { band: '' },
		call: function(req) {
			const b = str(req.args.band);
			return W.job_start('scan', index([ '2g', '5g' ], b) >= 0 ? { band: b } : {});
		}
	},

	set_uplink: {
		args: { mode: 'auto', ssid: '', bssid: '', band: '', key: '', encryption: '' },
		call: function(req) {
			const a = req.args;
			const mode = str(a.mode) || 'auto';
			if (index([ 'auto', 'lan', 'wifi' ], mode) < 0)
				return { ok: false, error: 'Chế độ kết nối không hợp lệ.' };
			const r = { mode: mode };
			if (length(str(a.ssid))) {
				if (index([ '2g', '5g' ], a.band) < 0)
					return { ok: false, error: 'Băng tần không hợp lệ.' };
				r.ssid = a.ssid;
				r.band = a.band;
				r.key = str(a.key);
				r.encryption = str(a.encryption) || (length(r.key) ? 'psk2' : 'none');
			}
			return W.job_start('uplink', r);
		}
	},

	set_guest: {
		args: { ssid: '' },
		call: function(req) {
			const s = str(req.args.ssid);
			if (length(s) < 1 || length(s) > 32)
				return { ok: false, error: 'Tên WiFi khách cần từ 1 đến 32 ký tự.' };
			return W.job_start('guest', { ssid: s });
		}
	},

	reconnect: {
		call: function() {
			return W.job_start('reconnect', {});
		}
	},

	pair: {
		args: { code: '' },
		call: function(req) {
			const code = replace(uc(str(req.args.code)), /[^A-Z0-9]/g, '');
			if (!match(code, /^[A-Z0-9]{12}$/))
				return { ok: false, error: 'Mã kết nối gồm 12 chữ và số.' };
			return W.job_start('pair', { code: code });
		}
	},

	unpair: {
		args: { force: false },
		call: function(req) {
			return W.job_start('unpair', { force: !!req.args.force });
		}
	},

	activate: {
		args: { ssid: '' },
		call: function(req) {
			const s = str(req.args.ssid);
			if (length(s) > 32)
				return { ok: false, error: 'Tên WiFi khách cần từ 1 đến 32 ký tự.' };
			return W.job_start('activate', length(s) ? { ssid: s } : {});
		}
	},

	// Wiflow Setup page data (files and netifd only; quick)
	overview: {
		call: function() {
			return W.overview();
		}
	},

	inet: {
		call: function() {
			return W.inet();
		}
	},

	log: {
		call: function() {
			return { ok: true, log: W.wlog_list(250) };
		}
	},

	// About 3 s (five pings)
	netcheck: {
		call: function() {
			return W.netcheck();
		}
	},

	reboot: {
		call: function() {
			if (W.job_busy())
				return { ok: false, error: 'Một thay đổi khác đang được xử lý, vui lòng đợi.' };
			W.wlog('system', 'Khởi động lại từ Wiflow Setup');
			W.run('setsid sh -c "sleep 2; reboot" </dev/null >/dev/null 2>&1 &');
			return { ok: true };
		}
	},

	change_login: {
		args: { username: '', password: '' },
		call: function(req) {
			const p = str(req.args.password);
			if (length(p) < 8)
				return { ok: false, error: 'Mật khẩu mới tối thiểu 8 ký tự.' };
			const e = W.setup_set_login(str(req.args.username), p);
			if (e)
				return { ok: false, error: e };
			W.wlog('security', 'Đã đổi tài khoản đăng nhập Wiflow Setup');
			return { ok: true, session: true };
		}
	},

	// "Kiểm tra WiFi nguồn" (about 3 minutes)
	wifitest: {
		args: { ssid: '', band: '', key: '', encryption: '' },
		call: function(req) {
			const a = req.args;
			if (!length(str(a.ssid)) || index([ '2g', '5g' ], a.band) < 0)
				return { ok: false, error: 'Chọn WiFi nguồn cần kiểm tra.' };
			return W.job_start('wifitest', { ssid: a.ssid, band: a.band, key: str(a.key), encryption: str(a.encryption) || (length(str(a.key)) ? 'psk2' : 'none') });
		}
	},

	reset: {
		call: function() {
			return W.job_start('reset', {});
		}
	},

	diag: {
		args: { send: false },
		call: function(req) {
			return W.job_start('diag', { send: !!req.args.send });
		}
	},

	job_clear: {
		call: function() {
			if (!W.job_busy())
				W.st_set('job', null);
			return { ok: true };
		}
	}
};

return { wiflow: methods };
