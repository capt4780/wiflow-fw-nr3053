#!/usr/bin/env python3
# Test double for nslookup: the router's resolver answers only while the mock world has Internet on the default route.
import json, subprocess, sys
r = subprocess.run(['ip', 'route', 'get', '1.1.1.1'], capture_output=True, text=True).stdout.split()
dev = r[r.index('dev') + 1] if 'dev' in r else None
w = json.load(open('/tmp/mock/world.json'))
ok = bool(dev) and w.get('inet', {}).get(dev, False) and not w.get('block_dns', False)
sys.exit(0 if ok else 1)
