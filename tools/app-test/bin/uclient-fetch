#!/usr/bin/env python3
# Test double for uclient-fetch: -T secs, -q, -O FILE, --post-data=, --header=
import sys, urllib.request, urllib.error
a = sys.argv[1:]; out = None; data = None; hdr = {}; url = None; to = 15
while a:
    k = a.pop(0)
    if k == '-T': to = float(a.pop(0))
    elif k == '-q': pass
    elif k == '-O': out = a.pop(0)
    elif k.startswith('--post-data='): data = k.split('=', 1)[1].encode()
    elif k.startswith('--header='):
        n, v = k.split('=', 1)[1].split(':', 1); hdr[n.strip()] = v.strip()
    else: url = k
if url and ('connectivitycheck' in url or 'detectportal' in url):
    # the mock world answers the Internet probe: it works while the default route's device has Internet
    import json, subprocess
    rr = subprocess.run(['ip', 'route', 'get', '1.1.1.1'], capture_output=True, text=True).stdout.split()
    dev = rr[rr.index('dev') + 1] if 'dev' in rr else None
    w = json.load(open('/tmp/mock/world.json'))
    ok = bool(dev) and w.get('inet', {}).get(dev, False) and not w.get('block_https', False)
    if not ok:
        sys.stderr.write('Connection error: mock world offline\n'); sys.exit(4)
    sys.exit(0)
try:
    r = urllib.request.urlopen(urllib.request.Request(url, data=data, headers=hdr), timeout=to)
    body = r.read()
except urllib.error.HTTPError as e:
    body = e.read()
    if out and out != '/dev/null': open(out, 'wb').write(body)
    sys.stderr.write('HTTP error %d\n' % e.code); sys.exit(8)
except Exception as e:
    sys.stderr.write('Connection error: %s\n' % e); sys.exit(4)
if out and out != '/dev/null': open(out, 'wb').write(body)
