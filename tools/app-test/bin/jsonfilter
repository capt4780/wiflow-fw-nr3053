#!/usr/bin/env python3
# Test double for OpenWrt jsonfilter: -i FILE -e '@.a.b[0].c' (only what Wiflow uses)
import json, re, sys
a = sys.argv[1:]
f = e = None
while a:
    k = a.pop(0)
    if k == '-i': f = a.pop(0)
    elif k == '-e': e = a.pop(0)
try:
    v = json.load(open(f))
except Exception:
    sys.exit(1)
for part in re.findall(r'\.([A-Za-z0-9_]+)|\[(\d+)\]', e[1:]):
    try:
        v = v[part[0]] if part[0] else v[int(part[1])]
    except Exception:
        sys.exit(1)
if isinstance(v, bool): v = 'true' if v else 'false'
print(json.dumps(v) if isinstance(v, (dict, list)) else v)
