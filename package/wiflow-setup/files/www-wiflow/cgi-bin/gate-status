#!/bin/sh
. /usr/lib/wiflow/common.sh

if check_session >/dev/null 2>&1; then
    header_json
    echo '{"ok":true,"unlocked":true,"authenticated":true,"resumed":false}'
    exit 0
fi

if check_management_resume >/dev/null 2>&1; then
    g="$(make_gate_session)" || { header_json; echo '{"ok":true,"unlocked":false,"authenticated":false}'; exit 0; }
    s="$(make_session)" || { header_json; echo '{"ok":true,"unlocked":false,"authenticated":false}'; exit 0; }
    t="${s%%|*}"
    printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nSet-Cookie: WFGATE=%s; Path=/; HttpOnly; SameSite=Strict\r\nSet-Cookie: WFSESSION=%s; Path=/; HttpOnly; SameSite=Strict\r\n\r\n' "$g" "$t"
    echo '{"ok":true,"unlocked":true,"authenticated":true,"resumed":true}'
    exit 0
fi

if check_gate_session >/dev/null 2>&1; then
    header_json
    echo '{"ok":true,"unlocked":true,"authenticated":false,"resumed":false}'
else
    header_json
    echo '{"ok":true,"unlocked":false,"authenticated":false,"resumed":false}'
fi
