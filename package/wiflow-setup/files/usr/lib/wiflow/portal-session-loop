#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
current=/tmp/wiflow-portal-associated
DISCONNECT_GRACE=20

while true; do
    sleep 5
    guest="$(uci -q get wiflow.core.guest_ssid 2>/dev/null || echo Wiflow)"
    : > "$current"; queried=0
    for obj in $(ubus list 'hostapd.*' 2>/dev/null); do
        st="$(ubus call "$obj" get_status 2>/dev/null || true)"; [ -n "$st" ] || continue
        ssid="$(printf '%s' "$st" | jsonfilter -e '@.ssid' 2>/dev/null || true)"; [ "$ssid" = "$guest" ] || continue
        queried=1
        ubus call "$obj" get_clients 2>/dev/null | grep -Eo '"([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"' | tr -d '"' | tr 'a-f' 'A-F' >> "$current" || true
    done
    [ "$queried" = 1 ] || continue
    sort -u "$current" -o "$current" 2>/dev/null || true
    now="$(date +%s)"

    while read -r mac; do
        [ -n "$mac" ] || continue
        ip="$(awk -v m="$mac" 'toupper($2)==m{print $3;exit}' /tmp/dhcp.leases 2>/dev/null || true)"
        [ -n "$ip" ] || ip="$(ip neigh show dev br-wiflow 2>/dev/null | awk -v m="$mac" 'toupper($0) ~ m && /lladdr/{print $1;exit}')"
        [ -n "$ip" ] && /usr/lib/wiflow/portal-client ensure "$ip" >/dev/null 2>&1 || true
    done < "$current"

    for f in "$CLIENT_SESSIONS"/*; do
        [ -f "$f" ] || continue
        IFS='|' read -r mac cid sid ip connected authorized last absent < "$f" 2>/dev/null || continue
        case "${absent:-0}" in ''|*[!0-9]*) absent=0;; esac
        if grep -qx "$mac" "$current" 2>/dev/null; then
            newip="$(awk -v m="$mac" 'toupper($2)==m{print $3;exit}' /tmp/dhcp.leases 2>/dev/null || true)"; [ -n "$newip" ] || newip="$ip"
            if [ "$newip" != "$ip" ]; then
                # A DHCP reassignment is a state transition. Revoke the old
                # pair and persist the new IP BEFORE opening any new pair.
                had_grant=0
                # Always remove the old authorized pair and verify its
                # absence, even if the session claims it was unauthorized.
                # Local state alone cannot prove the nft set is empty.
                portal_nft_del "$ip" "$mac"
                if ! portal_nft_pair_revoked "$ip" "$mac"; then
                    /usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
                    state_set portal_error 'client_ip_old_authorization_revoke_failed'
                    continue
                fi
                if [ "${authorized:-0}" = 0 ] && portal_nft_pair_granted "$ip" "$mac"; then
                    had_grant=1
                    portal_nft_grant_del "$ip" "$mac"
                fi
                if ! client_session_write "$f" "$mac" "$cid" "$sid" "$newip" "$connected" "${authorized:-0}" "$now" 0; then
                    state_set portal_error 'client_ip_state_write_failed'
                    continue
                fi
                if [ "${authorized:-0}" != 0 ]; then
                    portal_nft_add "$newip" "$mac" ||
                        state_set portal_error 'client_ip_authorization_restore_failed'
                elif [ "$had_grant" = 1 ]; then
                    portal_nft_grant_add "$newip" "$mac" ||
                        state_set portal_error 'client_ip_grant_restore_failed'
                fi
            else
                client_session_write "$f" "$mac" "$cid" "$sid" "$ip" "$connected" "${authorized:-0}" "$now" 0 ||
                    state_set portal_error 'client_session_refresh_failed'
            fi
        else
            [ "$absent" -gt 0 ] || absent="$now"
            elapsed=$((now-absent))
            if [ "$elapsed" -ge "$DISCONNECT_GRACE" ]; then
                portal_nft_del "$ip" "$mac"
                # Never retire the session while its old forwarding grant
                # might still exist. Without nft readback, assume unsafe.
                if ! portal_nft_pair_revoked "$ip" "$mac"; then
                    /usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
                    state_set portal_error 'client_disconnect_revoke_unverified'
                    continue
                fi
                portal_nft_grant_del "$ip" "$mac"
                when="${last:-$now}"; case "$when" in ''|*[!0-9]*) when="$now";; esac
                event_enqueue disconnected "$cid" "$sid" "$when" || true
                rm -f "$f"
                : > "$HEARTBEAT_KICK" 2>/dev/null || true
            else
                client_session_write "$f" "$mac" "$cid" "$sid" "$ip" "$connected" "${authorized:-0}" "${last:-$now}" "$absent" || true
            fi
        fi
    done
done
