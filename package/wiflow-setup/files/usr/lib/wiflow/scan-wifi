#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
band="${1:-5g}"
case "$band" in 2g|5g) :;; *) exit 2;; esac
OUT=/tmp/wiflow-scan.out
: > "$OUT"
for r in $(uci -q show wireless 2>/dev/null | awk -F= '$2 == "wifi-device" {n=$1;sub(/^wireless\./,"",n);print n}'); do
    [ "$(radio_band "$r")" = "$band" ] || continue
    wifi_scan_radio "$r" | awk -F '\t' -v radio="$r" -v band="$band" '$1!="" {print radio "\t" band "\t" $1 "\t" $2 "\t" $3 "\t" $4}' >> "$OUT" 2>/dev/null || true
done
# Keep same SSID on different BSSID entries; only remove exact duplicate radio+SSID+BSSID.
awk -F '\t' '!seen[$1 FS $3 FS $4]++ && $3!="" {print}' "$OUT" > "$OUT.uniq" 2>/dev/null || true
mv "$OUT.uniq" "$OUT" 2>/dev/null || true
