#!/bin/sh
# v1.0.11: uhttpd interpreter for *.html in the Wiflow Setup / Gate web roots.
# uhttpd sends no Cache-Control for static files, so browsers kept old pages after
# an update. Serving the pages through here marks them no-store; versioned CSS/JS
# URLs (?v=) then always load the matching release.
f="${1:-}"
case "$f" in /www-wiflow/*.html|/www-wiflow-luci-gate/*.html) :;; *) printf 'Status: 403 Forbidden\r\n\r\n'; exit 0;; esac
case "$f" in *..*) printf 'Status: 403 Forbidden\r\n\r\n'; exit 0;; esac
[ -f "$f" ] || { printf 'Status: 404 Not Found\r\nContent-Type: text/plain\r\n\r\nNot found\n'; exit 0; }
printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store, no-cache, must-revalidate, max-age=0\r\nPragma: no-cache\r\nExpires: 0\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\n\r\n'
[ "${REQUEST_METHOD:-GET}" = HEAD ] || cat "$f"
