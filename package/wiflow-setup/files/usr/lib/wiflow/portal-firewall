#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
MODE="${1:-disable}"
NFT_DIR=/usr/share/nftables.d/table-post
NFT_FILE="$NFT_DIR/30-wiflow-captive.nft"

write_rules(){
 mkdir -p "$NFT_DIR" || return 1
 cat > "$NFT_FILE.tmp" <<'NFT'
set wiflow_portal_authed { type ipv4_addr . ether_addr; flags timeout; timeout 30d; }
set wiflow_portal_granted { type ipv4_addr . ether_addr; flags timeout; timeout 30m; }
set wiflow_portal_web4 { type ipv4_addr; }
chain wiflow_portal_prerouting {
 type nat hook prerouting priority -110; policy accept;
 ip saddr 10.10.10.0/24 ip daddr 10.0.0.1 return
 ip saddr 10.10.10.0/24 ip daddr 10.0.0.2 return
 ip saddr . ether saddr @wiflow_portal_authed return
 ip saddr 10.10.10.0/24 ip daddr @wiflow_portal_web4 return
 ip saddr 10.10.10.0/24 tcp dport 80 redirect to :2080
}
chain wiflow_portal_forward {
 type filter hook forward priority -10; policy accept;
 ip saddr . ether saddr @wiflow_portal_authed return
 ip saddr 10.10.10.0/24 tcp dport 853 accept
 ip saddr 10.10.10.0/24 udp dport 853 accept
 ip saddr 10.10.10.0/24 ip daddr @wiflow_portal_web4 tcp dport { 80, 443 } accept
 ip saddr 10.10.10.0/24 reject
}
NFT
 mv "$NFT_FILE.tmp" "$NFT_FILE" || return 1
 chmod 600 "$NFT_FILE" 2>/dev/null || true
}

# Reject internal and reserved DNS addresses before granting pre-auth Website WAN.
wiflow_public_ipv4(){
 printf '%s\n' "$1" | awk -F. '
   NF != 4 { exit 1 }
   {
     for (i = 1; i <= 4; i++) {
       if ($i !~ /^[0-9]+$/ || length($i) > 3 || $i + 0 > 255) exit 1
     }
     a=$1+0; b=$2+0; c=$3+0
     if (a == 0 || a == 10 || a == 127 || a >= 224) exit 1
     if (a == 100 && b >= 64 && b <= 127) exit 1
     if (a == 169 && b == 254) exit 1
     if (a == 172 && b >= 16 && b <= 31) exit 1
     if (a == 192 && (b == 0 || b == 168 || (b == 88 && c == 99))) exit 1
     if (a == 198 && (b == 18 || b == 19 || (b == 51 && c == 100))) exit 1
     if (a == 203 && b == 0 && c == 113) exit 1
     exit 0
   }'
}

resolve_website_ips(){
 cfg="$(portal_active_config)"; [ -n "$cfg" ] || return 1
 mode="$(uci -q get wiflow.core.portal_mode 2>/dev/null || true)"; case "$mode" in website|image|video) :;; *) mode="$(jsonfilter -i "$cfg" -e '@.mode' 2>/dev/null || true)";; esac; [ "$mode" = website ] || return 1
 url="$(jsonfilter -i "$cfg" -e '@.website_url' 2>/dev/null || true)"; website_url_valid "$url" || return 1
 host="$(website_host_from_url "$url")"; [ -n "$host" ] || return 1
 tmp="/tmp/wiflow-web-dns.$$"; raw="$tmp.raw"
 nslookup "$host" 2>/dev/null | awk '/^Name:[[:space:]]*/{seen=1;next} seen&&/^Address[[:space:]]*[0-9]*:[[:space:]]*/{ip=$0;sub(/^Address[[:space:]]*[0-9]*:[[:space:]]*/,"",ip);print ip} seen&&/^Address:[[:space:]]*/{ip=$0;sub(/^Address:[[:space:]]*/,"",ip);print ip}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u > "$raw" 2>/dev/null || true
 # DNS alone does not grant guest access to router, private or special ranges.
 while IFS= read -r ip; do
  wiflow_public_ipv4 "$ip" && printf '%s\n' "$ip"
 done < "$raw" > "$tmp"
 rm -f "$raw"
 [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
 cat "$tmp"; rm -f "$tmp"
}

refresh(){
 /usr/sbin/nft list set inet fw4 wiflow_portal_web4 >/dev/null 2>&1 || return 1
 /usr/sbin/nft flush set inet fw4 wiflow_portal_web4 >/dev/null 2>&1 || return 1
 ips="$(resolve_website_ips 2>/dev/null || true)"
 [ -n "$ips" ] || { state_set website_walled_garden 0; return 0; }
 for ip in $ips; do printf 'add element inet fw4 wiflow_portal_web4 { %s }\n' "$ip" | /usr/sbin/nft -f - >/dev/null 2>&1 || return 1; done
 state_set website_walled_garden 1
 return 0
}

enable(){
 # Forwarding must not be opened before a complete local Portal snapshot.
 [ -f "$PORTAL_ACTIVE/portal.json" ] || { state_set portal_error 'snapshot_missing'; return 1; }
 write_rules || return 1
 uci -q delete firewall.wiflow_guest_wan >/dev/null 2>&1 || true
 uci set firewall.wiflow_guest_wan='forwarding'
 uci set firewall.wiflow_guest_wan.src='wiflow_guest'
 uci set firewall.wiflow_guest_wan.dest='wan'
 uci -q delete firewall.wiflow_guest_portal >/dev/null 2>&1 || true
 uci set firewall.wiflow_guest_portal='rule'; uci set firewall.wiflow_guest_portal.name='Wiflow-Captive-Portal'; uci set firewall.wiflow_guest_portal.src='wiflow_guest'; uci set firewall.wiflow_guest_portal.proto='tcp'; uci set firewall.wiflow_guest_portal.dest_port='2080'; uci set firewall.wiflow_guest_portal.target='ACCEPT'; uci commit firewall || return 1
 # The WAN forwarding has just been selected: never leave it configured
 # if fw4 rejects the captive chain or either authorization set is missing.
 if ! /etc/init.d/firewall reload >/dev/null 2>&1; then
  state_set portal_error 'captive_reload_failed'
  disable || state_set portal_error 'captive_rollback_failed'
  return 1
 fi
 if ! portal_nft_ready ||
    ! /usr/sbin/nft list chain inet fw4 wiflow_portal_prerouting >/dev/null 2>&1 ||
    ! /usr/sbin/nft list chain inet fw4 wiflow_portal_forward >/dev/null 2>&1; then
  state_set portal_error 'captive_chains_missing'
  disable || state_set portal_error 'captive_rollback_failed'
  return 1
 fi
 refresh || true
 state_set portal_error ''
 return 0
}

ensure(){
 # No active snapshot means guest Internet must stay closed.
 [ -f "$PORTAL_ACTIVE/portal.json" ] || { disable; return 1; }
 # Fast path: both the captive rules AND the forwarding owner must be ready.
 # Called by the mode loop every 2s; no gratuitous firewall reload.
 if [ "$(uci -q get firewall.wiflow_guest_wan 2>/dev/null || true)" = forwarding ] && portal_nft_ready && /usr/sbin/nft list chain inet fw4 wiflow_portal_prerouting >/dev/null 2>&1 && /usr/sbin/nft list chain inet fw4 wiflow_portal_forward >/dev/null 2>&1; then
  return 0
 fi
 enable
}

disable(){
 changed=0
 [ -f "$NFT_FILE" ] && changed=1
 uci -q get firewall.wiflow_guest_portal >/dev/null 2>&1 && changed=1
 uci -q get firewall.wiflow_guest_wan >/dev/null 2>&1 && changed=1
 rm -f "$NFT_FILE" "$NFT_FILE.tmp" || return 1
 uci -q delete firewall.wiflow_guest_portal >/dev/null 2>&1 || true
 uci -q delete firewall.wiflow_guest_wan >/dev/null 2>&1 || true
 uci commit firewall >/dev/null 2>&1 || return 1
 if [ "$changed" = 1 ]; then
  /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
 fi
 return 0
}
case "$MODE" in enable) enable;; ensure) ensure;; refresh) refresh;; disable) disable;; *) exit 2;; esac
