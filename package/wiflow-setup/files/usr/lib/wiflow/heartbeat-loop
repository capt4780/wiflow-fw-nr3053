#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh

probe_connection(){
 mode="$(uci -q get wiflow.core.internet_mode 2>/dev/null || true)"; link=0
 case "$mode" in wifi) iface_up wiflow_wwan && iface_route_active wiflow_wwan && link=1;; lan) iface_up wan && iface_route_active wan && link=1;; *) mode=none;; esac
 now="$(date +%s)"; last="$(state_get internet_probe_at 2>/dev/null || echo 0)"; case "$last" in ''|*[!0-9]*) last=0;; esac
 live="$(state_get internet_live 2>/dev/null || echo 0)"; [ "$live" = 1 ] || live=0
 if [ "$link" = 0 ]; then
  live=0; state_set internet_live 0; state_set internet_probe_at "$now"
 elif [ $((now-last)) -ge 30 ]; then
  if internet_probe_fast; then live=1; state_set internet_live 1; state_set internet_last_ok "$now"; else live=0; state_set internet_live 0; fi
  state_set internet_probe_at "$now"
 fi
 printf '%s|%s' "$mode" "$live"
}

build_events_json(){
 batch="$1"; first=1; printf '['
 while IFS='|' read -r eid cid sid event occurred; do
  [ -n "$eid" ] || continue
  [ "$first" = 1 ] || printf ','; first=0
  printf '{"event_id":"%s","client_id":"%s","session_id":"%s","event_type":"%s","occurred_at":%s}' \
   "$(json_escape "$eid")" "$(json_escape "$cid")" "$(json_escape "$sid")" "$(json_escape "$event")" "${occurred:-0}"
 done < "$batch"
 printf ']'
}

sleep_with_kick(){ seconds="$1"; i=0; while [ "$i" -lt "$seconds" ]; do [ -f "$HEARTBEAT_KICK" ] && { rm -f "$HEARTBEAT_KICK"; return 0; }; sleep 1; i=$((i+1)); done; }

portal_runtime_disable(){
 uci set wiflow.core.portal_enabled='0'
 uci commit wiflow >/dev/null 2>&1 || true
 /usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
}

portal_runtime_reconcile(){
 wanted="$1"; desired="$2"; current="$3"
 if [ "$wanted" != 1 ] || [ "$desired" -le 0 ]; then
  portal_runtime_disable
  return 0
 fi
 if [ "$desired" -ne "$current" ] || [ ! -f "$PORTAL_ACTIVE/portal.json" ]; then
  if ! /usr/lib/wiflow/portal-sync "$desired" >/dev/null 2>&1; then
   # Never tear down a known-good captive Portal because a newer revision
   # failed to sync. Keep the active local snapshot serving clients.
   if [ -f "$PORTAL_ACTIVE/portal.json" ]; then
    uci set wiflow.core.portal_enabled='1'
    uci commit wiflow >/dev/null 2>&1 || true
    /usr/lib/wiflow/portal-firewall ensure >/dev/null 2>&1 || true
    return 1
   fi
   portal_runtime_disable
   return 1
  fi
 fi
 [ -f "$PORTAL_ACTIVE/portal.json" ] || { portal_runtime_disable; return 1; }
 uci set wiflow.core.portal_enabled='1'
 uci commit wiflow >/dev/null 2>&1 || true
 if ! /usr/lib/wiflow/portal-firewall enable >/dev/null 2>&1; then
  portal_runtime_disable
  state_set portal_error 'captive_firewall_enable_failed'
  return 1
 fi
 return 0
}

delay=20
while true; do
 paired="$(uci -q get wiflow.core.paired 2>/dev/null || echo 0)"; token="$(device_token)"; did="$(device_id)"
 conn="$(probe_connection)"; mode="${conn%%|*}"; live="${conn#*|}"; ssid=''; [ "$mode" = wifi ] && ssid="$(uci -q get wiflow.core.source_ssid 2>/dev/null || true)"; guest="$(uci -q get wiflow.core.guest_ssid 2>/dev/null || echo Wiflow)"
 if [ "$paired" = 1 ] && [ -n "$token" ] && [ -n "$did" ]; then
  batch="/tmp/wiflow-event-batch.$$"; count="$(event_prepare_batch "$batch" 30 2>/dev/null || echo 0)"; case "$count" in ''|*[!0-9]*) count=0;; esac; events="$(build_events_json "$batch")"
  rev="$(uci -q get wiflow.core.portal_revision 2>/dev/null || echo 0)"; case "$rev" in ''|*[!0-9]*) rev=0;; esac
  sync="$(uci -q get wiflow.core.portal_sync_status 2>/dev/null || echo idle)"; err="$(uci -q get wiflow.core.portal_sync_error 2>/dev/null || true)"
  cr_id="$(uci -q get wiflow.core.last_command_id 2>/dev/null || true)"; cr_action="$(uci -q get wiflow.core.last_command_action 2>/dev/null || true)"; cr_status="$(uci -q get wiflow.core.last_command_status 2>/dev/null || true)"; cr_msg="$(uci -q get wiflow.core.last_command_message 2>/dev/null || true)"
  [ -n "$cr_id" ] && command_result="{\"id\":\"$(json_escape "$cr_id")\",\"action\":\"$(json_escape "$cr_action")\",\"status\":\"$(json_escape "$cr_status")\",\"message\":\"$(json_escape "$cr_msg")\"}" || command_result='null'
  [ "$live" = 1 ] && internet=true || internet=false
  body="{\"agent_version\":\"$WIFLOW_AGENT_VERSION\",\"data_generation\":$WIFLOW_DATA_GENERATION,\"internet\":$internet,\"connection\":\"$(json_escape "$mode")\",\"wifi_ssid\":\"$(json_escape "$ssid")\",\"guest_ssid\":\"$(json_escape "$guest")\",\"active_portal_revision\":$rev,\"portal_sync_status\":\"$(json_escape "$sync")\",\"portal_sync_error\":\"$(json_escape "$err")\",\"events\":$events,\"command_result\":$command_result}"
  resp="/tmp/wiflow-heartbeat-response.$$"; rm -f "$resp"; umask 077
  if wiflow_post "$resp" "$WIFLOW_DEVICE_API/heartbeat" "$body" >/dev/null 2>&1; then ok="$(jsonfilter -i "$resp" -e '@.ok' 2>/dev/null || true)"; else ok=''; fi
  if [ "$ok" = true ] || [ "$ok" = 1 ]; then
   generation="$(jsonfilter -i "$resp" -e '@.data_generation' 2>/dev/null || true)"
   if [ "$generation" != "$WIFLOW_DATA_GENERATION" ]; then
    state_set wp_online 0; state_set api_error "generation_mismatch:$generation"; delay=60
    portal_runtime_disable
   else
    state_set wp_online 1; state_set wp_last_ok "$(date +%s)"; state_set api_error ''; delay=20
    account_public_id="$(jsonfilter -i "$resp" -e '@.account_public_id' 2>/dev/null || true)"
    if printf '%s' "$account_public_id" | grep -Eq '^WIFID[A-Z0-9]{7}$'; then
     current_account_public_id="$(uci -q get wiflow.core.account_public_id 2>/dev/null || true)"
     if [ "$current_account_public_id" != "$account_public_id" ]; then uci set "wiflow.core.account_public_id=$account_public_id"; uci commit wiflow >/dev/null 2>&1 || true; secure_configs; fi
    fi
    [ "$count" -gt 0 ] && event_ack_batch "$count" >/dev/null 2>&1 || true
    pen="$(jsonfilter -i "$resp" -e '@.portal_enabled' 2>/dev/null || true)"; case "$pen" in true|1) wanted=1;; *) wanted=0;; esac
    desired="$(jsonfilter -i "$resp" -e '@.desired_portal_revision' 2>/dev/null || echo 0)"; case "$desired" in ''|*[!0-9]*) desired=0;; esac
    current="$(uci -q get wiflow.core.portal_revision 2>/dev/null || echo 0)"; case "$current" in ''|*[!0-9]*) current=0;; esac
    portal_runtime_reconcile "$wanted" "$desired" "$current" >/dev/null 2>&1 || true
    /usr/lib/wiflow/remote-command "$resp" >/dev/null 2>&1 || true
   fi
  else
   state_set wp_online 0
   code="$(jsonfilter -i "$resp" -e '@.code' 2>/dev/null || true)"
   [ -n "$code" ] && state_set api_error "$code" || state_set api_error 'heartbeat_transport'
   if [ "$code" = DEVICE_AUTH_INVALID ] || [ "$code" = DEVICE_AUTH_MISSING ]; then
    pairing_clear_local; delay=20
   else
    delay=$((delay*2)); [ "$delay" -gt 180 ] && delay=180
   fi
  fi
  rm -f "$resp" "${resp}.fetch-error" "$batch"
 else
  state_set wp_online 0; delay=20
 fi
 sleep_with_kick "$delay"
done
