#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
mode="${1:-setup}"
uplink_band="${2:-}"
stage="${3:-full}"
guest_ssid="$(uci -q get wiflow.core.guest_ssid 2>/dev/null || echo Wiflow)"
r2="$(radio_for_band 2g 2>/dev/null || true)"
r5="$(radio_for_band 5g 2>/dev/null || true)"

# NR3053 dual-band radio policy must not silently accept missing mapping.
[ -n "$r2" ] && [ -n "$r5" ] && [ "$r2" != "$r5" ] || exit 3

configure_radio(){
    r="$1"; band="$2"
    [ -n "$r" ] || return 1
    uci set "wireless.$r.disabled=0" || return 1
    uci set "wireless.$r.country=VN" || return 1
    if [ "$band" = 2g ]; then
        uci set "wireless.$r.channel=6" || return 1
        uci set "wireless.$r.htmode=HE20" || return 1
    else
        uci set "wireless.$r.channel=36" || return 1
        uci set "wireless.$r.htmode=HE40" || return 1
    fi
}
ensure_guest(){
    sec="$1"; r="$2"; disabled="$3"
    [ -n "$r" ] || return 1
    uci -q delete "wireless.$sec" >/dev/null 2>&1 || true
    uci set "wireless.$sec=wifi-iface" || return 1
    uci set "wireless.$sec.device=$r" || return 1
    uci set "wireless.$sec.mode=ap" || return 1
    uci set "wireless.$sec.network=wiflow_guest" || return 1
    uci set "wireless.$sec.ssid=$guest_ssid" || return 1
    uci set "wireless.$sec.encryption=none" || return 1
    uci set "wireless.$sec.disabled=$disabled" || return 1
}
# Disable stock/default AP sections so Wiflow has one canonical AP per radio.
for sec in $(uci -q show wireless 2>/dev/null | awk -F= '$2 == "wifi-iface" {n=$1;sub(/^wireless\./,"",n);print n}'); do
    case "$sec" in wiflow_guest_2g|wiflow_guest_5g|wiflow_uplink) continue;; esac
    [ "$(uci -q get wireless.$sec.mode 2>/dev/null || true)" = ap ] || continue
    uci set "wireless.$sec.disabled=1" || exit 1
done

d2=0; d5=0
case "$mode" in
  wan|setup) d2=0; d5=0;;
  wifi)
    d2=0; d5=0
    case "$uplink_band" in
      5g)
        [ -n "$r5" ] || exit 3
        uci set "wireless.$r5.disabled=0" || exit 1
        uci set "wireless.$r5.channel=auto" || exit 1
        [ "$stage" = anchor ] && d5=1
        ;;
      2g)
        [ -n "$r2" ] || exit 3
        uci set "wireless.$r2.disabled=0" || exit 1
        uci set "wireless.$r2.channel=auto" || exit 1
        [ "$stage" = anchor ] && d2=1
        ;;
      *) exit 2;;
    esac;;
  *) exit 2;;
esac
if [ "$uplink_band" != 2g ]; then configure_radio "$r2" 2g || exit 1; fi
if [ "$uplink_band" != 5g ]; then configure_radio "$r5" 5g || exit 1; fi
ensure_guest wiflow_guest_2g "$r2" "$d2" || exit 1
ensure_guest wiflow_guest_5g "$r5" "$d5" || exit 1
uci commit wireless || exit 1
exit 0
