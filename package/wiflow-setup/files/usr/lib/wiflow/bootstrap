#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
ROOT=/etc/wiflow
LOG=/tmp/wiflow-bootstrap.log
mkdir -p "$ROOT" /www-wiflow /www-wiflow-portal /www-wiflow-portal/runtime/revisions /www-wiflow-luci-gate 2>/dev/null || true
chmod 700 "$ROOT" 2>/dev/null || true
log(){ printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)" "$*" >> "$LOG"; }
wait_for_br_lan(){ i=0; while [ "$i" -lt 30 ]; do ip link show br-lan >/dev/null 2>&1 && return 0; sleep 1; i=$((i+1)); done; return 1; }
ensure_device_id(){
    current="$(cat "$ROOT/device-id" 2>/dev/null | tr -d '\r\n')"
    case "$current" in WIFDID-NR3053-[0-9][0-9][0-9][0-9][0-9][0-9]) return 0;; esac
    raw="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')"
    case "$raw" in ''|*[!0-9]*) raw="$(date +%s 2>/dev/null || echo 123456)";; esac
    pin=$(( (raw % 900000) + 100000 ))
    printf 'WIFDID-NR3053-%06d\n' "$pin" > "$ROOT/device-id"
    chmod 600 "$ROOT/device-id"
}
backup_stock_configs(){
    b="$ROOT/stock"
    [ -f "$b/.complete" ] && return 0
    mkdir -p "$b" || return 1
    for f in network wireless firewall dhcp uhttpd; do [ -f "/etc/config/$f" ] && cp "/etc/config/$f" "$b/$f" 2>/dev/null || true; done
    : > "$b/.complete"; chmod -R go-rwx "$b" 2>/dev/null || true
}
ensure_management_network(){
    uci -q get network.lan >/dev/null 2>&1 || return 1
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr='10.0.0.1'
    uci set network.lan.netmask='255.255.255.0'
    uci set network.lan.delegate='0'
    uci -q delete network.lan.ip6assign >/dev/null 2>&1 || true
    uci -q delete network.lan.ip6hint >/dev/null 2>&1 || true
    uci -q delete network.lan.ip6ifaceid >/dev/null 2>&1 || true
    uci commit network
}
ensure_luci_ip(){
    ip link show br-lan >/dev/null 2>&1 || return 1
    ip addr show dev br-lan 2>/dev/null | grep -q '10\.0\.0\.2/' || ip addr add 10.0.0.2/32 dev br-lan 2>/dev/null || true
    ip addr show dev br-lan 2>/dev/null | grep -q '10\.0\.0\.2/'
}
cleanup_legacy_management_ips(){
    ip addr del 192.168.10.2/32 dev br-lan >/dev/null 2>&1 || true
    ip addr del 192.168.10.1/24 dev br-lan >/dev/null 2>&1 || true
}
wait_for_management_ip(){ i=0; while [ "$i" -lt 30 ]; do ip addr show dev br-lan 2>/dev/null | grep -q '10\.0\.0\.1/' && return 0; sleep 1; i=$((i+1)); done; return 1; }
wait_for_guest_ip(){ i=0; while [ "$i" -lt 30 ]; do ip addr show dev br-wiflow 2>/dev/null | grep -q '10\.10\.10\.1/' && return 0; sleep 1; i=$((i+1)); done; return 1; }
tcp_listening(){ addr="$1"; port="$2"; [ -r /proc/net/tcp ] || return 1; awk -v target="${addr}:${port}" '$2 == target && $4 == "0A" {ok=1} END{exit(ok?0:1)}' /proc/net/tcp; }
configure_web(){
    [ -f /etc/config/uhttpd ] || return 1
    uci -q get uhttpd.main >/dev/null 2>&1 || return 1
    [ -f "$ROOT/uhttpd.stock" ] || cp /etc/config/uhttpd "$ROOT/uhttpd.stock" 2>/dev/null || return 1

    # LuCI is intentionally available only at 10.0.0.2:8081 and is
    # protected by the six-digit Wiflow Security Gate at 10.0.0.2:80.
    uci -q delete uhttpd.main.listen_http >/dev/null 2>&1 || true
    uci -q delete uhttpd.main.listen_https >/dev/null 2>&1 || true
    uci add_list uhttpd.main.listen_http='10.0.0.2:8081' || return 1

    uci -q delete uhttpd.wiflow_luci_gate >/dev/null 2>&1 || true
    uci set uhttpd.wiflow_luci_gate='uhttpd'
    uci add_list uhttpd.wiflow_luci_gate.listen_http='10.0.0.2:80'
    uci set uhttpd.wiflow_luci_gate.home='/www-wiflow-luci-gate'
    uci set uhttpd.wiflow_luci_gate.cgi_prefix='/cgi-bin'
    uci add_list uhttpd.wiflow_luci_gate.index_page='index.html'
    uci set uhttpd.wiflow_luci_gate.script_timeout='10'
    uci set uhttpd.wiflow_luci_gate.network_timeout='5'
    uci set uhttpd.wiflow_luci_gate.http_keepalive='5'
    uci set uhttpd.wiflow_luci_gate.max_requests='2'
    uci set uhttpd.wiflow_luci_gate.max_connections='8'

    uci -q delete uhttpd.wiflow >/dev/null 2>&1 || true
    uci set uhttpd.wiflow='uhttpd'
    uci add_list uhttpd.wiflow.listen_http='10.0.0.1:80'
    uci set uhttpd.wiflow.home='/www-wiflow'
    uci set uhttpd.wiflow.cgi_prefix='/cgi-bin'
    uci add_list uhttpd.wiflow.index_page='index.html'
    uci set uhttpd.wiflow.script_timeout='20'
    uci set uhttpd.wiflow.network_timeout='10'
    uci set uhttpd.wiflow.http_keepalive='10'
    uci set uhttpd.wiflow.max_requests='4'
    uci set uhttpd.wiflow.max_connections='20'

    uci -q delete uhttpd.wiflow_portal >/dev/null 2>&1 || true
    uci set uhttpd.wiflow_portal='uhttpd'
    uci add_list uhttpd.wiflow_portal.listen_http='10.10.10.1:2080'
    uci set uhttpd.wiflow_portal.home='/www-wiflow-portal'
    uci set uhttpd.wiflow_portal.cgi_prefix='/cgi-bin'
    uci add_list uhttpd.wiflow_portal.index_page='index.html'
    uci set uhttpd.wiflow_portal.error_page='/cgi-bin/portal'
    uci set uhttpd.wiflow_portal.rfc1918_filter='0'
    uci set uhttpd.wiflow_portal.script_timeout='10'
    uci set uhttpd.wiflow_portal.network_timeout='5'
    uci set uhttpd.wiflow_portal.http_keepalive='5'
    uci set uhttpd.wiflow_portal.max_requests='4'
    uci set uhttpd.wiflow_portal.max_connections='24'
    uci commit uhttpd || return 1
    /etc/init.d/uhttpd restart >/dev/null 2>&1 || true
    /etc/init.d/firewall reload >/dev/null 2>&1 || true

    i=0
    while [ "$i" -lt 10 ]; do
        tcp_listening 0100000A 0050 && tcp_listening 0200000A 0050 && tcp_listening 0200000A 1F91 && tcp_listening 010A0A0A 0820 && return 0
        sleep 1; i=$((i+1))
    done
    return 1
}

wait_for_br_lan || { log 'br-lan unavailable'; exit 0; }
/usr/lib/wiflow/minimal-profile >/dev/null 2>&1 || log 'Minimal runtime profile could not be fully applied'
ensure_device_id
if [ "$(uci -q get wiflow.core.last_command_status 2>/dev/null || true)" = rebooting ]; then
    cid="$(uci -q get wiflow.core.last_command_id 2>/dev/null || true)"
    act="$(uci -q get wiflow.core.last_command_action 2>/dev/null || echo reboot)"
    [ -n "$cid" ] && command_result_set "$cid" "$act" success 'Thiết bị đã khởi động lại' || true
fi
backup_stock_configs || log 'Could not save stock configuration backup'
recover_uplink_transaction && log 'Recovered interrupted uplink transaction' || true
ensure_management_network || log 'Could not update LAN management subnet'
ensure_guest_network
ensure_uplink_network
tune_wiflow_runtime
ubus call network reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1 || true
wait_for_management_ip || log 'Management IP 10.0.0.1 not confirmed'
ensure_luci_ip || log 'LuCI IP 10.0.0.2/32 not confirmed'
cleanup_legacy_management_ips
wait_for_guest_ip || log 'Guest IP 10.10.10.1 not confirmed'
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
/etc/init.d/firewall reload >/dev/null 2>&1 || true
secure_configs
# The last confirmed remote enable/disable state is authoritative across
# reboots. An existing cached snapshot does not override an explicit WP
# disable. At a WP outage a previously enabled valid snapshot keeps working.
saved_portal_enabled="$(uci -q get wiflow.core.portal_enabled 2>/dev/null || true)"
if [ "$saved_portal_enabled" = 1 ] && [ -f "$PORTAL_ACTIVE/portal.json" ]; then
    /usr/lib/wiflow/portal-firewall ensure >/dev/null 2>&1 ||
        log 'Captive portal firewall could not be enabled'
else
    # Missing snapshot is fail-closed even if a stale enabled flag survived.
    # Do not write UCI flash repeatedly for an already disabled Portal.
    if [ "$saved_portal_enabled" != 0 ]; then
        uci set wiflow.core.portal_enabled='0'
        uci commit wiflow >/dev/null 2>&1 || log 'Could not persist disabled Portal state'
    fi
    /usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 ||
        log 'Captive portal firewall could not be disabled'
fi
uplink_radio="$(uci -q get wireless.wiflow_uplink.device 2>/dev/null || true)"
uplink_ssid="$(uci -q get wireless.wiflow_uplink.ssid 2>/dev/null || true)"
if [ -n "$uplink_radio" ] && [ -n "$uplink_ssid" ]; then
    uplink_band="$(radio_band "$uplink_radio")"
    /usr/lib/wiflow/radio-policy wifi "$uplink_band" >/dev/null 2>&1 || log 'Saved WiFi radio policy could not be restored'
else
    /usr/lib/wiflow/radio-policy setup >/dev/null 2>&1 || log 'Initial radio policy could not be applied'
fi
wifi reload >/dev/null 2>&1 || true
if configure_web; then log 'Wiflow Setup active on 10.0.0.1; Security Gate on 10.0.0.2:80; LuCI on 10.0.0.2:8081'; else log 'Wiflow web listener configuration failed'; fi
rm -f /etc/wiflow/reboot-required >/dev/null 2>&1 || true
exit 0
