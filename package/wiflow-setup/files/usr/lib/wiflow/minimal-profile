#!/bin/sh
# Wiflow Dedicated Mode runtime profile.
# Goal: keep the router focused on Wiflow while preserving safe rollback.
# Optional packages are never uninstalled; only their daemons are stopped/disabled.
set -u
ROOT=/etc/wiflow
STATE="$ROOT/minimal-services.state"
LOG=/tmp/wiflow-minimal-profile.log
mkdir -p "$ROOT" 2>/dev/null || true
chmod 700 "$ROOT" 2>/dev/null || true

log(){ printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)" "$*" >> "$LOG"; }
was_enabled(){ svc="$1"; ls /etc/rc.d/S*"$svc" >/dev/null 2>&1; }
state_has(){ svc="$1"; [ -f "$STATE" ] && grep -q "^${svc}|" "$STATE" 2>/dev/null; }
record_services(){
    [ -f "$STATE" ] || { : > "$STATE" || return 1; chmod 600 "$STATE" 2>/dev/null || true; }
    for svc in "$@"; do
        [ -x "/etc/init.d/$svc" ] || continue
        state_has "$svc" && continue
        if was_enabled "$svc"; then
            printf '%s|enabled\n' "$svc" >> "$STATE"
        else
            printf '%s|disabled\n' "$svc" >> "$STATE"
        fi
    done
}

# Services not required by Wiflow's transport, Wi-Fi AP/uplink, DHCP/DNS,
# firewall/NAT, captive portal, local UI, API/heartbeat or rescue access.
# Keep core/recovery services such as network, dnsmasq, firewall, wpad/hostapd,
# uhttpd, rpcd, dropbear, sysntpd, logd, ubus and procd untouched.
OPTIONAL_SERVICES='\
adblock adblock-fast banip sqm qos mwan3 ddns miniupnpd \
samba samba4 ksmbd minidlna transmission aria2 collectd luci_statistics \
dockerd tailscale zerotier openvpn nodogsplash opennds wifidog \
travelmate umdns avahi-daemon p910nd vsftpd nfsd snmpd ttyd \
odhcpd nlbwmon usteer wifischedule wifi-schedule vnstat vnstat2 \
haproxy nginx lighttpd apache2 php8-fastcgi php7-fastcgi mosquitto \
xinetd inetd'

# Append state for services introduced by newer Wiflow versions instead of
# replacing the existing rollback file. This preserves the true pre-Wiflow
# state across package upgrades.
# shellcheck disable=SC2086
record_services $OPTIONAL_SERVICES || true

for svc in $OPTIONAL_SERVICES; do
    [ -x "/etc/init.d/$svc" ] || continue
    "/etc/init.d/$svc" stop >/dev/null 2>&1 || true
    "/etc/init.d/$svc" disable >/dev/null 2>&1 || true
    log "disabled optional service: $svc"
done

exit 0
