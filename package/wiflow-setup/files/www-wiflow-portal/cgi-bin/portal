#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
headers(){ printf 'Content-Type: %s\r\nCache-Control: no-store\r\nPragma: no-cache\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\n\r\n' "$1"; }
json_error(){ headers 'application/json; charset=utf-8'; printf '{"ok":false,"error":"%s"}\n' "$(json_escape "$1")"; exit 0; }
validate_session(){
 sid="$1"; printf '%s' "$sid" | grep -Eq '^[0-9a-fA-F]{16,64}$' || return 1
 ip="${REMOTE_ADDR:-}"; valid_guest_ip "$ip" || return 1
 f="$(client_find_file_by_session "$sid" 2>/dev/null || true)"; [ -n "$f" ] && [ -f "$f" ] || return 1
 IFS='|' read -r mac cid stored_sid session_ip connected authorized last absent < "$f" 2>/dev/null || return 1
 [ "$stored_sid" = "$sid" ] && [ "$session_ip" = "$ip" ] || return 1
 return 0
}
# v1.0.12: a guest that is already authorized but whose request still reached
# the portal (a connection opened before the confirm) gets the answer its OS
# check expects, so iOS/Android/Windows mark the WiFi as online at once.
authorized_reply(){
 host="$(printf '%s' "${HTTP_HOST:-}" | tr 'A-Z' 'a-z')"; host="${host%%:*}"; uri="${REQUEST_URI:-/}"
 case "$host$uri" in
  *apple.com*|*/hotspot-detect*|*/library/test/success*)
   printf 'Content-Type: text/html\r\nCache-Control: no-store\r\nX-Wiflow-Portal: 1\r\n\r\n<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>\n';;
  *msftconnecttest.com*) printf 'Content-Type: text/plain\r\nCache-Control: no-store\r\nX-Wiflow-Portal: 1\r\n\r\nMicrosoft Connect Test';;
  *msftncsi.com*) printf 'Content-Type: text/plain\r\nCache-Control: no-store\r\nX-Wiflow-Portal: 1\r\n\r\nMicrosoft NCSI';;
  *detectportal.firefox.com*) printf 'Content-Type: text/plain\r\nCache-Control: no-store\r\nX-Wiflow-Portal: 1\r\n\r\nsuccess\n';;
  *) authorized_204;;
 esac
 exit 0
}
authorized_204(){ printf 'Status: 204 No Content\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Private-Network: true\r\nAccess-Control-Expose-Headers: X-Wiflow-Portal, X-Wiflow-Uplink\r\nX-Wiflow-Portal: 1\r\nX-Wiflow-Uplink: %s\r\nCache-Control: no-store\r\n\r\n' "$(uplink_hint)"; }
# Router Internet status from the background check: 1 online, 0 offline, ? unknown.
uplink_hint(){ set -- $(net_status_read); echo "$1"; }
# v1.0.11: allow the authorize call from the phone's captive-check origin.
if [ "${REQUEST_METHOD:-GET}" = OPTIONS ]; then printf 'Status: 204 No Content\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Methods: POST, GET, OPTIONS\r\nAccess-Control-Allow-Headers: Content-Type\r\nAccess-Control-Allow-Private-Network: true\r\nAccess-Control-Expose-Headers: X-Wiflow-Portal, X-Wiflow-Uplink\r\nAccess-Control-Max-Age: 600\r\nCache-Control: no-store\r\n\r\n'; exit 0; fi
[ "${REQUEST_METHOD:-GET}" = POST ] && read_body || BODY=''
action="$(param action 2>/dev/null || true)"
case "$action" in
 authorize)
  # v1.0.15: the confirm only opens the Internet. Everything else was
  # prepared in the background while the guest was watching the portal.
  t0="$(ms_now)"
  sid="$(param session_id 2>/dev/null || true)"; validate_session "$sid" || { printf 'Status: 403 Forbidden\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Expose-Headers: X-Wiflow-Portal\r\nX-Wiflow-Portal: 1\r\nCache-Control: no-store\r\n\r\n'; exit 0; }
  set -- $(net_status_read); nv="$1"; na="$2"
  # As in 1.0.4: no grant while the router itself is known to be offline
  # (a result older than 90 s is not trusted, so a stopped check never blocks guests).
  if [ "$nv" = 0 ] && [ "$na" -le 90 ]; then
   printf 'Status: 503 Service Unavailable\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Expose-Headers: X-Wiflow-Portal\r\nX-Wiflow-Portal: 1\r\nCache-Control: no-store\r\n\r\n'
   timing_write authorize "$(date +%s) no_internet $(( $(ms_now) - t0 ))ms net=$nv age=${na}s"
   exit 0
  fi
  if /usr/lib/wiflow/portal-client authorize-session "$sid" "$cid" >/dev/null 2>&1; then
   authorized_204
   timing_write authorize "$(date +%s) granted $(( $(ms_now) - t0 ))ms net=$nv age=${na}s"
   ( event_enqueue content_interaction "$cid" "$sid" "$(date +%s)" ) </dev/null >/dev/null 2>&1 &
  else
   printf 'Status: 409 Conflict\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Expose-Headers: X-Wiflow-Portal\r\nX-Wiflow-Portal: 1\r\nCache-Control: no-store\r\n\r\n'
   timing_write authorize "$(date +%s) failed $(( $(ms_now) - t0 ))ms"
  fi
  exit 0;;
 done)
  printf 'Status: 302 Found\r\nLocation: /connected.html\r\nCache-Control: no-store\r\n\r\n'; exit 0;;
 prepare)
  # v1.0.15: called silently when the portal opens. Makes sure the captive
  # firewall is up and the router's Internet status is fresh (check <= 2 s),
  # so the confirm never has to wait. The guest sees nothing of this.
  t0="$(ms_now)"
  printf 'Status: 204 No Content\r\nCache-Control: no-store\r\nX-Wiflow-Portal: 1\r\n\r\n'
  portal_nft_ready || ( /usr/lib/wiflow/portal-firewall ensure ) </dev/null >/dev/null 2>&1 &
  net_refresh_if_stale 30
  set -- $(net_status_read)
  timing_write prepare "$(date +%s) $(( $(ms_now) - t0 ))ms net=$1"
  exit 0;;
 event)
  sid="$(param session_id 2>/dev/null || true)"; validate_session "$sid" || json_error 'invalid_session'
  ev="$(param event 2>/dev/null || true)"; case "$ev" in portal_view|content_impression|content_interaction) event_enqueue "$ev" "$cid" "$sid" "$(date +%s)" || true;; *) json_error 'invalid_event';; esac
  headers 'application/json; charset=utf-8'; echo '{"ok":true}'; exit 0;;
esac

enabled="$(uci -q get wiflow.core.portal_enabled 2>/dev/null || echo 0)"; [ "$enabled" = 1 ] || { printf 'Status: 204 No Content\r\nCache-Control: no-store\r\n\r\n'; exit 0; }
ip="${REMOTE_ADDR:-}"; valid_guest_ip "$ip" || { printf 'Status: 403 Forbidden\r\nCache-Control: no-store\r\n\r\n'; exit 0; }
session="$(/usr/lib/wiflow/portal-client ensure "$ip" 2>/dev/null || true)"; [ -n "$session" ] || { headers 'text/html; charset=utf-8'; echo '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="2"><p>Đang chuẩn bị kết nối WiFi…</p>'; exit 0; }
cid="${session%%|*}"; sid="${session#*|}"
if /usr/lib/wiflow/portal-client is-authorized "$sid" >/dev/null 2>&1; then authorized_reply; fi

event_enqueue portal_view "$cid" "$sid" "$(date +%s)" || true
cfg="$PORTAL_ACTIVE/portal.json"
mode="$(uci -q get wiflow.core.portal_mode 2>/dev/null || true)"; case "$mode" in website|image|video) :;; *) mode=""; [ -f "$cfg" ] && mode="$(jsonfilter -i "$cfg" -e '@.mode' 2>/dev/null || true)";; esac
case "$mode" in website|image|video) :;; *) mode='';; esac
# v1.0.7: while a low-space update has freed the old media, show the same portal
# layout without background media (website template), so guests can always connect.
if [ -n "$mode" ] && [ "$(jsonfilter -i "$cfg" -e '@.fallback' 2>/dev/null || true)" = true ]; then mode=website; fi
if [ -z "$mode" ]; then
 headers 'text/html; charset=utf-8'
 cat <<'HTML'
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Wiflow WiFi</title><style>html,body{height:100%;margin:0;font-family:Arial,sans-serif;background:#f5f5f5;color:#333}body{display:grid;place-items:center}.box{text-align:center;padding:24px}.box b{display:block;font-size:18px;margin-bottom:8px}.box span{font-size:14px;color:#777}</style></head><body><div class="box"><b>Đang đồng bộ WiFi Marketing</b><span>Thiết bị chưa nhận đủ nội dung Portal.</span></div></body></html>
HTML
 exit 0
fi
template="/www-wiflow-portal/template-$mode.html"; [ -f "$template" ] || { printf 'Status: 500 Internal Server Error\r\nCache-Control: no-store\r\n\r\n'; exit 0; }
headers 'text/html; charset=utf-8'
sed "s/__SESSION_ID__/$sid/g" "$template"
