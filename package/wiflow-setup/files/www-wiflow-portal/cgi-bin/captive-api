#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
printf 'Content-Type: application/captive+json\r\nCache-Control: no-store\r\nPragma: no-cache\r\nAccess-Control-Allow-Origin: *\r\n\r\n'
ip="${REMOTE_ADDR:-}"
if ! valid_guest_ip "$ip"; then
  printf '{"captive":true,"user-portal-url":"http://10.10.10.1:2080/cgi-bin/portal"}\n'
  exit 0
fi
session="$(/usr/lib/wiflow/portal-client ensure "$ip" 2>/dev/null || true)"
if [ -n "$session" ]; then
  sid="${session#*|}"
  if /usr/lib/wiflow/portal-client is-authorized "$sid" >/dev/null 2>&1; then
    printf '{"captive":false}\n'
    exit 0
  fi
fi
printf '{"captive":true,"user-portal-url":"http://10.10.10.1:2080/cgi-bin/portal"}\n'
