#!/bin/sh /etc/rc.common
# Wiflow ROM: keep the MediaTek hardware NAT (pulled in by the WiFi driver)
# out of the packet path, so the captive portal and the firewall see every
# packet. Same state as the stable firmware with acceleration off.
START=11

start() {
	[ -w /sys/kernel/debug/hnat/hook_toggle ] && echo 0 > /sys/kernel/debug/hnat/hook_toggle
	return 0
}
