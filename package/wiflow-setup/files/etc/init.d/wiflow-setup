#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
    # A failed management bootstrap must never start heartbeat or Portal daemons.
    # An on-device config rollback is not physical firmware recovery.
    if ! /usr/lib/wiflow/bootstrap >>/tmp/wiflow-bootstrap.log 2>&1; then
        logger -t wiflow-setup -p daemon.err 'BOOTSTRAP_BLOCK: management not verified; Wiflow loops not started'
        return 1
    fi
    procd_open_instance heartbeat
    procd_set_param command /usr/lib/wiflow/heartbeat-loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
    procd_open_instance portal_mode
    procd_set_param command /usr/lib/wiflow/portal-mode-loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
    procd_open_instance portal_sessions
    procd_set_param command /usr/lib/wiflow/portal-session-loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
