# Wiflow ROM (Viettel NR3053, MediaTek mt_wifi). Radio names come from the
# driver's l1profile (MT7981_1_1 = ra0 / 2.4 GHz, MT7981_1_2 = rax0 / 5 GHz).
# The guest APs stay off until Wiflow has set up its guest network at boot.

config wifi-device 'MT7981_1_1'
	option type 'mtwifi'
	option phy 'ra0'
	option band '2g'
	option dbdc_main '1'
	option channel '6'
	option txpower '100'
	option htmode 'HE20'
	option country 'VN'
	option mu_beamformer '1'
	option noscan '1'
	option serialize '1'

config wifi-device 'MT7981_1_2'
	option type 'mtwifi'
	option phy 'rax0'
	option band '5g'
	option dbdc_main '0'
	option channel '36'
	option txpower '100'
	option htmode 'HE80'
	option country 'VN'
	option mu_beamformer '1'
	option noscan '0'
	option serialize '1'

config wifi-iface 'wiflow_guest_2g'
	option device 'MT7981_1_1'
	option mode 'ap'
	option network 'wiflow_guest'
	option ssid 'Wiflow'
	option encryption 'none'
	option disabled '1'

config wifi-iface 'wiflow_guest_5g'
	option device 'MT7981_1_2'
	option mode 'ap'
	option network 'wiflow_guest'
	option ssid 'Wiflow'
	option encryption 'none'
	option disabled '1'
