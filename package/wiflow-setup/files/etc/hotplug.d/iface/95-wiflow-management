#!/bin/sh
[ "${ACTION:-}" = ifup ] || exit 0
[ "${INTERFACE:-}" = lan ] || exit 0
ip link show br-lan >/dev/null 2>&1 || exit 0
ip addr show dev br-lan 2>/dev/null | grep -q '10\.0\.0\.1/' || ip addr add 10.0.0.1/24 dev br-lan 2>/dev/null || true
ip addr show dev br-lan 2>/dev/null | grep -q '10\.0\.0\.2/' || ip addr add 10.0.0.2/32 dev br-lan 2>/dev/null || true
