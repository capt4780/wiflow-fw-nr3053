define Package/wiflow-setup/preinst
#!/bin/sh
[ -n "$${IPKG_INSTROOT:-}" ] && exit 0

# Preserve the current Wiflow configuration for an in-place compatible upgrade.
if [ -f /etc/config/wiflow ]; then
    cp /etc/config/wiflow /tmp/wiflow-preupgrade-config 2>/dev/null || true
    chmod 600 /tmp/wiflow-preupgrade-config 2>/dev/null || true
    : > /tmp/wiflow-preupgrade-present
fi

if [ -f /usr/lib/wiflow/common.sh ] && grep -q "WIFLOW_DATA_GENERATION='4'" /usr/lib/wiflow/common.sh 2>/dev/null; then
    : > /tmp/wiflow-preupgrade-compatible
fi
exit 0
endef

define Package/wiflow-setup/postinst
#!/bin/sh
[ -n "$${IPKG_INSTROOT:-}" ] && exit 0
set -e
mkdir -p /etc/config /etc/wiflow
upgrading=0; compatible_upgrade=0
if [ -f /tmp/wiflow-preupgrade-present ] && [ -s /tmp/wiflow-preupgrade-config ]; then
    upgrading=1
    cp /tmp/wiflow-preupgrade-config /etc/config/wiflow
fi
[ -f /tmp/wiflow-preupgrade-compatible ] && compatible_upgrade=1
rm -f /tmp/wiflow-preupgrade-config /tmp/wiflow-preupgrade-present /tmp/wiflow-preupgrade-compatible
uci -q get wiflow.core >/dev/null 2>&1 || uci set wiflow.core='core'

if [ "$$compatible_upgrade" = 1 ]; then
    # Preserve pairing, token and active Portal state on a compatible in-place upgrade.
    uci -q get wiflow.core.guest_ssid >/dev/null 2>&1 || uci set wiflow.core.guest_ssid='Wiflow'
else
    # Incompatible remote state must not cross the protocol boundary.
    uci set wiflow.core.paired='0'
    uci set wiflow.core.pair_required='0'
    uci set wiflow.core.portal_enabled='0'
    uci set wiflow.core.portal_revision='0'
    uci set wiflow.core.portal_sync_status='idle'
    uci set wiflow.core.portal_sync_error=''
    for k in device_token client_hash_salt remote_protocol portal_url api_url api_code protocol supported_protocols last_command_id last_command_action last_command_status last_command_message portal_mode; do
        uci -q delete "wiflow.core.$$k" >/dev/null 2>&1 || true
    done
    rm -rf /www-wiflow-portal/runtime/revisions /www-wiflow-portal/runtime/active /www-wiflow-portal/runtime/.staging-* /www-wiflow-portal/runtime/.active-* 2>/dev/null || true
    mkdir -p /www-wiflow-portal/runtime/revisions
fi
uci set wiflow.core.data_generation='4'
uci -q get wiflow.core.internet_verified >/dev/null 2>&1 || uci set wiflow.core.internet_verified='0'
uci -q get wiflow.core.setup_step >/dev/null 2>&1 || uci set wiflow.core.setup_step='2'
uci commit wiflow
chmod 600 /etc/config/wiflow 2>/dev/null || true
rm -f /tmp/wiflow-events.queue /tmp/wiflow-heartbeat-kick /tmp/wiflow-pair-last-error /tmp/wiflow-state 2>/dev/null || true
rm -rf /tmp/wiflow-client-sessions/* 2>/dev/null || true

# Web assets: never let a link/copy problem abort the install (v1.0.8).
. /usr/lib/wiflow/common.sh 2>/dev/null && wiflow_link_assets || true
# v1.0.21: LuCI uses the Wiflow theme from now on (fonts shared with Setup).
. /usr/lib/wiflow/common.sh 2>/dev/null && { wiflow_link_luci_fonts; wiflow_link_luci_web; luci_theme_enforce; rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null; } || true
# v1.0.23: LuCI root password 1234 (fresh install: always; upgrade: only if root has none).
. /usr/lib/wiflow/common.sh 2>/dev/null && { if [ "$$upgrading" = 1 ] || [ "$$compatible_upgrade" = 1 ]; then luci_root_pw_default 0; else luci_root_pw_default 1; fi; } || true
ubus list iwinfo >/dev/null 2>&1 || echo 'Wiflow: rpcd iwinfo (LuCI) not available - Setup cannot scan for source WiFi.'
rm -f /etc/rc.d/S95wiflow-setup >/dev/null 2>&1 || true
/etc/init.d/wiflow-setup enable >/dev/null 2>&1 || true
# v1.0.12: running loops still hold the previous code in memory; let procd
# respawn them with the new scripts (no network/WiFi change). Captive rules
# move to their own table on the next 15 s check. Reboot still recommended.
for n in portal-session-loop portal-mode-loop heartbeat-loop; do
    for pid in $$(pgrep -f "/usr/lib/wiflow/$$n" 2>/dev/null || true); do kill "$$pid" 2>/dev/null || true; done
done
printf '%s\n' '1.0.26' > /etc/wiflow/reboot-required
chmod 600 /etc/wiflow/reboot-required 2>/dev/null || true
if [ "$$compatible_upgrade" = 1 ]; then
    echo 'Wiflow Setup V1 installed. Existing pairing and runtime state were preserved.'
elif [ "$$upgrading" = 1 ]; then
    echo 'Wiflow Setup V1 installed. Internet configuration was retained; incompatible remote state was reset.'
else
    echo 'Wiflow Setup V1 installed. Reboot the router to start Wiflow.'
fi
exit 0
endef

define Package/wiflow-setup/prerm
#!/bin/sh
[ -n "$${IPKG_INSTROOT:-}" ] && exit 0

# An in-place upgrade must not disturb the currently active Wi-Fi/network.
# The replacement package is intentionally applied on the next reboot.
case "$${1:-}" in
    upgrade|deconfigure) exit 0 ;;
esac

/etc/init.d/wiflow-setup stop >/dev/null 2>&1 || true
/usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
# v1.0.21: the service (and its theme check) is stopped; hand LuCI back to Bootstrap.
. /usr/lib/wiflow/common.sh 2>/dev/null && luci_theme_release || true
exit 0
endef

define Package/wiflow-setup/postrm
#!/bin/sh
[ -n "$${IPKG_INSTROOT:-}" ] && exit 0
[ "$${1:-}" = remove ] || exit 0
/usr/lib/wiflow/restore-minimal-profile >/dev/null 2>&1 || true
/usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
uci -q delete uhttpd.wiflow_portal >/dev/null 2>&1 || true
uci -q delete uhttpd.wiflow_luci_gate >/dev/null 2>&1 || true
uci -q delete uhttpd.wiflow >/dev/null 2>&1 || true
uci commit uhttpd >/dev/null 2>&1 || true
# v1.0.21: LuCI back to Bootstrap. Package files (common.sh) are already gone
# here, so this is self-contained; prerm did the same while they still existed.
if [ -f /etc/config/luci ] && [ "$$(uci -q get luci.main.mediaurlbase)" = /luci-static/wiflow ] || uci -q get luci.themes.Wiflow >/dev/null 2>&1; then
    uci -q delete luci.themes.Wiflow >/dev/null 2>&1 || true
    uci set luci.themes.Bootstrap='/luci-static/bootstrap' >/dev/null 2>&1 || true
    uci set luci.main.mediaurlbase='/luci-static/bootstrap' >/dev/null 2>&1 || true
    uci commit luci >/dev/null 2>&1 || true
fi
rm -rf /www/luci-static/wiflow/fonts /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null || true
ip addr del 10.0.0.2/32 dev br-lan >/dev/null 2>&1 || true
b=/etc/wiflow/stock
if [ -f "$$b/.complete" ]; then
    for f in network wireless firewall dhcp uhttpd; do [ -f "$$b/$$f" ] && cp "$$b/$$f" "/etc/config/$$f"; done
    ubus call network reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1 || true
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
    /etc/init.d/firewall restart >/dev/null 2>&1 || true
    /etc/init.d/uhttpd restart >/dev/null 2>&1 || true
    wifi reload >/dev/null 2>&1 || true
fi
exit 0
endef

$(eval $(call BuildPackage,wiflow-setup))
