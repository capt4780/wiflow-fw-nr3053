{#
 Wiflow theme for LuCI — derived from luci-theme-bootstrap (openwrt-25.12)
 Copyright 2022 Jo-Philipp Wich
 Licensed to the public under the Apache License 2.0.
 Wiflow: an access code (gate) comes before the login form; see
 /usr/share/ucode/wiflow/gate.uc. The dispatcher refuses credentials until
 the gate is passed, so this page only decides which form to show.
-#}

{%
	import { passed as gate_passed, attempt as gate_attempt } from 'wiflow.gate';

	const gate_try = gate_attempt(http);
	if (gate_try?.cookie)
		http.header('Set-Cookie', gate_try.cookie);

	const gate_ok = gate_try?.ok || gate_passed(http);
	const login_user = fuser ?? 'wiflow';
-%}

{% include('header', { blank_page: true, wf_login: true }) %}

<div class="w-gate">
	<img src="{{ media }}/wiflow-mark.webp" alt="Wiflow">
	{% if (!gate_ok): %}
	<div class="w-tt" data-title="Security code"><h1>{{ _('Security code') }}</h1><p>{{ _('Enter the device code to continue') }}</p></div>
	<form class="w-f" method="post" autocomplete="off">
		<div class="w-fld">
			<label for="wf_gate_code">{{ _('Security code') }}</label>
			<div class="w-in"><input name="wf_gate_code" id="wf_gate_code" type="text" autocapitalize="characters" autocorrect="off" spellcheck="false" inputmode="text"></div>
		</div>
		{% if (gate_try?.error == 'locked'): %}
		<p class="w-err">{{ sprintf(_('Too many wrong codes. Try again in %d seconds.'), gate_try.wait) }}</p>
		{% elif (gate_try?.error == 'invalid'): %}
		<p class="w-err">{{ sprintf(_('Wrong security code. %d attempts left.'), gate_try.left) }}</p>
		{% endif %}
		<button class="w-btn w-p w-full" type="submit" data-busy="{{ entityencode(_('Checking…'), true) }}">{{ _('Continue') }}</button>
	</form>
	{% else %}
	<div class="w-tt" data-title="Sign in"><h1>{{ _('Sign in') }}</h1><p>{{ _('Wiflow router administration') }}</p></div>
	<form class="w-f" method="post">
		<div class="w-fld">
			<label for="luci_username">{{ _('Sign-in name') }}</label>
			<div class="w-in"><input name="luci_username" id="luci_username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" value="{{ entityencode(login_user, true) }}"></div>
		</div>
		<div class="w-fld">
			<label for="luci_password">{{ _('Password') }}</label>
			<div class="w-in"><input name="luci_password" id="luci_password" type="password" autocomplete="current-password"></div>
		</div>
		{% if (fuser && gate_passed(http)): %}
		<p class="w-err">{{ _('Invalid username and/or password! Please try again.') }}</p>
		{% endif %}
		<button class="w-btn w-p w-full" type="submit" data-busy="{{ entityencode(_('Logging in…'), true) }}">{{ _('Log in') }}</button>
	</form>
	{% endif %}
</div>

<div id="view">
	<script>
		L.require('ui').then(function(ui) {
			ui.instantiateView('wiflow.sysauth');
		});
	</script>
</div>

{% include('footer', { blank_page: true }) %}
