{%
	import { readfile } from 'fs';

	const wiflow_os = trim(readfile('/etc/wiflow_release') ?? '');
-%}

		{% if (!blank_page): %}
		</div>
		<footer>
			<span>
				Wiflow OS {{ wiflow_os }} · Powered by
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
				/ OpenWrt
			</span>
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>
		</div>
		</div>
		<script>L.require('menu-wiflow')</script>
		{% endif %}
	</body>
</html>
