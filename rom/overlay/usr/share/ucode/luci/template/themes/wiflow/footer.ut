{%
	
	const at = ctx.request_path?.[1];
	const nav = [
		[ 'wiflow', _('Overview'), '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>' ],
		[ 'wifi', _('Internet'), '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>' ],
		[ 'system', _('System'), '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg>' ]
	];
-%}

		{% if (!blank_page): %}
		</div></main>
		</div>
		<nav class="w-tabbar">
			{% for (let n in nav): %}
			<a class="{{ at == n[0] ? 'w-on' : '' }}" href="{{ dispatcher.build_url('admin', n[0]) }}"><span class="w-p">{{ n[2] }}</span>{{ n[1] }}</a>
			{% endfor %}
		</nav>
		<ul id="modemenu" style="display:none"></ul>
		</div>
		<script>L.require('menu-wiflow')</script>
		{% endif %}
	</body>
</html>
