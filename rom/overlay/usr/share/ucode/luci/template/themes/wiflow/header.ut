{#
 Wiflow theme for LuCI — derived from luci-theme-bootstrap (openwrt-25.12)
 Copyright 2008 Steven Barth, 2012 David Menting, 2008-2022 Jo-Philipp Wich
 Licensed to the public under the Apache License 2.0.
 Same blocks/ids as Bootstrap (#topmenu, #indicators, #maincontent, #tabmenu,
 #modemenu) so every LuCI view works unchanged; only the frame differs.
-#}

{%
	import { getuid, getspnam } from 'luci.core';
	import { readfile } from 'fs';

	const boardinfo = ubus.call('system', 'board');
	const model = striptags(boardinfo?.model ?? 'Wiflow router');
	const wiflow_os = trim(readfile('/etc/wiflow_release') ?? '');
	const device_id = 'WIFDIDNR3053';

	const at = ctx.request_path?.[1];
	const cur_lang = (dispatcher.lang == 'vi') ? 'vi' : 'en';
	const nav = [
		[ 'wiflow', _('Overview'), '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>' ],
		[ 'wifi', _('Network'), '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>' ],
		[ 'system', _('System'), '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg>' ]
	];
	const out_icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5M15 8l4 4-4 4M19 12H9"/></svg>';
	const flag = {
		vi: '<svg class="w-fl" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" fill="#DA251D"/><path d="M12.00 5.40 L13.65 10.13 L18.66 10.24 L14.66 13.27 L16.11 18.06 L12.00 15.20 L7.89 18.06 L9.34 13.27 L5.34 10.24 L10.35 10.13z" fill="#FFCD00"/></svg>',
		en: '<svg class="w-fl" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" fill="#1F3A93"/><path d="M0 0L24 24M24 0L0 24" stroke="#fff" stroke-width="4.5"/><path d="M0 0L24 24M24 0L0 24" stroke="#D52B3A" stroke-width="1.6"/><path d="M12 0v24M0 12h24" stroke="#fff" stroke-width="7"/><path d="M12 0v24M0 12h24" stroke="#D52B3A" stroke-width="4"/></svg>'
	};

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" translate="no" class="notranslate" data-darkmode="false">
	<head>
		<meta charset="utf-8">
		<meta name="google" content="notranslate">
		<title>{{ striptags(node?.title ? `${node.title} · Wiflow` : 'Wiflow') }}</title>
		<meta name="viewport" content="initial-scale=1.0,width=device-width">
		<meta name="theme-color" content="#F2F4F8">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="stylesheet" href="{{ media }}/wiflow.css">
		<link rel="icon" type="image/png" href="{{ media }}/favicon.png">
		<link rel="apple-touch-icon" href="{{ media }}/apple-touch-icon.png">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}{{ wf_login ? ' wf-login' : '' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div class="w-app">
		<aside class="w-side">
			<a class="w-lg" href="{{ dispatcher.build_url('admin') }}" aria-label="Wiflow"><img src="{{ media }}/wiflow-mark.webp" alt="Wiflow">{% if (device_id): %}<span class="w-code" title="{{ model }}">{{ device_id }}</span>{% endif %}</a>
			<nav class="w-nv">
				{% for (let n in nav): %}
				<a class="{{ at == n[0] ? 'w-on' : '' }}" href="{{ dispatcher.build_url('admin', n[0]) }}">{{ n[2] }}<span class="w-l">{{ n[1] }}</span></a>
				{% endfor %}
			</nav>
			<div class="w-lang" data-lang="{{ cur_lang }}">
				<button class="w-lb" type="button" aria-label="{{ _('Language') }}">{{ flag[cur_lang] }}<span class="w-ln">{{ cur_lang == 'vi' ? 'Tiếng Việt' : 'English' }}</span><svg class="w-cv2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg></button>
				<div class="w-lm">
					<button type="button" data-l="vi" class="{{ cur_lang == 'vi' ? 'w-on' : '' }}">{{ flag.vi }}Tiếng Việt<svg class="w-tk" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-9"/></svg></button>
					<button type="button" data-l="en" class="{{ cur_lang == 'en' ? 'w-on' : '' }}">{{ flag.en }}English<svg class="w-tk" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-9"/></svg></button>
				</div>
			</div>
			<a class="w-out" href="{{ dispatcher.build_url('admin') }}/logout">{{ out_icon }}<span class="w-l">{{ _('Sign out') }}</span></a>
		</aside>
		<div class="w-main">
		<header class="w-topm">
			<a class="w-lg" href="{{ dispatcher.build_url('admin') }}" aria-label="Wiflow"><img src="{{ media }}/wiflow-mark.webp" alt="Wiflow"></a>
			<div class="w-tr">
				<div class="w-lang" data-lang="{{ cur_lang }}">
					<button class="w-lb" type="button" aria-label="{{ _('Language') }}">{{ flag[cur_lang] }}</button>
					<div class="w-lm">
						<button type="button" data-l="vi" class="{{ cur_lang == 'vi' ? 'w-on' : '' }}">{{ flag.vi }}Tiếng Việt<svg class="w-tk" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-9"/></svg></button>
						<button type="button" data-l="en" class="{{ cur_lang == 'en' ? 'w-on' : '' }}">{{ flag.en }}English<svg class="w-tk" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-9"/></svg></button>
					</div>
				</div>
				<a class="w-ib" href="{{ dispatcher.build_url('admin') }}/logout" aria-label="{{ _('Sign out') }}">{{ out_icon }}</a>
			</div>
		</header>

		<main id="maincontent" class="w-pg"><div class="w-col">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
