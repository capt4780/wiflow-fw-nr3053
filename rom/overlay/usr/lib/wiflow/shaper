#!/bin/sh
# Wiflow auto fair-share: starts/stops the controller and removes its queues.
#   shaper run     controller (background, one instance)
#   shaper stop    stop and remove the queues
. /usr/lib/wiflow/common.sh
BR=br-wiflow; IFB=ifb0; TC="${TC:-tc}"; PID=/tmp/wiflow-shaper.pid; ST=/tmp/wiflow-shaper
shaper_clean(){
    $TC qdisc del dev "$BR" root >/dev/null 2>&1; $TC qdisc del dev "$BR" ingress >/dev/null 2>&1
    $TC qdisc del dev "$IFB" root >/dev/null 2>&1; return 0
}
case "${1:-}" in
run)
    [ -f "$PID" ] && kill -0 "$(cat "$PID" 2>/dev/null)" 2>/dev/null && exit 0
    echo $$ > "$PID"
    ip link show "$IFB" >/dev/null 2>&1 || ip link add "$IFB" type ifb >/dev/null 2>&1
    ip link set "$IFB" up >/dev/null 2>&1
    tgt=1.1.1.1; [ -n "$(ping_ms $tgt)" ] || tgt=8.8.8.8
    sd=0; su=0; if [ -f "$ST" ]; then set -- $(cat "$ST" 2>/dev/null); sd="${2:-0}"; su="${3:-0}"; fi
    wlog guest 'Tự động chia đều: bắt đầu'
    ping -n -i 1 -W 1 "$tgt" 2>/dev/null | awk -f /usr/lib/wiflow/shaper.awk \
        -v BR="$BR" -v IFB="$IFB" -v TC="$TC" -v SYS="/sys/class/net/$BR/statistics" \
        -v GCMD="awk -F'|' '\$6+0>0{print \$4}' $CLIENT_SESSIONS/* 2>/dev/null" \
        -v MAXDN="$(cfg_num guest_down_kbps 0)" -v MAXUP="$(cfg_num guest_up_kbps 0)" \
        -v START_DN="$sd" -v START_UP="$su" -v STATUS="$ST"
    rc=$?
    shaper_clean; rm -f "$PID"
    [ "$rc" = 3 ] && { state_set shaper_err "$(uptime_s)"; wlog guest 'Tự động chia đều: lỗi, quay về giới hạn cố định'; }
    exit 0
    ;;
stop)
    [ -f "$PID" ] && { p="$(cat "$PID" 2>/dev/null)"; kill "$p" 2>/dev/null; pkill -P "$p" ping 2>/dev/null; }
    shaper_clean; rm -f "$PID" "$ST"
    ;;
*) exit 2 ;;
esac
