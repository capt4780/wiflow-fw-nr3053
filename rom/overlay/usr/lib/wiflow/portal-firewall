#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
MODE="${1:-disable}"
# v1.0.12: the captive rules live in their own nftables table. fw4 rebuilds
# only "table inet fw4" on every reload (uplink re-join, DHCP, LuCI save), so
# guest authorizations are no longer wiped by a firewall reload.
LEGACY_FILE=/usr/share/nftables.d/table-post/30-wiflow-captive.nft
MARK='wiflow-captive-v4'

apply_rules(){
 # One atomic transaction. Declaring an existing set keeps its elements,
 # so re-applying never drops an authorized guest.
 /usr/sbin/nft -f - <<NFT
table inet wiflow_captive {
 set authed { type ipv4_addr . ether_addr; flags timeout; timeout 30d; }
 set web4 { type ipv4_addr; }
 set dl { type ipv4_addr; flags dynamic,timeout; timeout 2m; size 1024; }
 set ul { type ipv4_addr; flags dynamic,timeout; timeout 2m; size 1024; }
 chain shape { }
 chain sched_fwd { }
 chain sched_nat { }
 chain prerouting { type nat hook prerouting priority -110; policy accept; }
 chain forward { type filter hook forward priority -10; policy accept; }
 chain input { type filter hook input priority -10; policy accept; }
 chain postrouting { type filter hook postrouting priority 50; policy accept; }
}
flush chain inet wiflow_captive prerouting
flush chain inet wiflow_captive forward
flush chain inet wiflow_captive input
flush chain inet wiflow_captive postrouting
table inet wiflow_captive {
 chain prerouting {
  ip saddr 10.10.10.0/24 ip daddr 10.0.0.1 return
  ip saddr 10.10.10.0/24 ip daddr 10.0.0.2 return
  jump sched_nat
  ip saddr . ether saddr @authed return
  ip saddr 10.10.10.0/24 ip daddr @web4 return
  ip saddr 10.10.10.0/24 tcp dport 80 redirect to :2080 comment "$MARK"
 }
 chain forward {
  jump sched_fwd
  ip daddr 10.10.10.0/24 counter comment "guest-in"
  jump shape
  ip saddr . ether saddr @authed counter return comment "guest-authed"
  ip saddr 10.10.10.0/24 tcp dport 853 accept
  ip saddr 10.10.10.0/24 udp dport 853 accept
  ip saddr 10.10.10.0/24 ip daddr @web4 tcp dport { 80, 443 } accept
  ip saddr 10.10.10.0/24 meta l4proto tcp reject with tcp reset
  ip saddr 10.10.10.0/24 reject comment "$MARK"
 }
 # Counters only (never drop): read by /cgi-bin/diag to show where guest traffic stops.
 chain input {
  ip saddr 10.10.10.0/24 udp dport 53 counter comment "guest-dns"
 }
 chain postrouting {
  ip saddr 10.10.10.0/24 oifname != "br-wiflow" counter comment "guest-out"
 }
}
NFT
}

rules_current(){
 /usr/sbin/nft list chain inet wiflow_captive prerouting 2>/dev/null | grep -q "$MARK" &&
 /usr/sbin/nft list chain inet wiflow_captive forward 2>/dev/null | grep -q "$MARK"
}

resolve_website_ips(){
 cfg="$(portal_active_config)"; [ -n "$cfg" ] || return 1
 mode="$(uci -q get wiflow.core.portal_mode 2>/dev/null || true)"; case "$mode" in website|image|video) :;; *) mode="$(jsonfilter -i "$cfg" -e '@.mode' 2>/dev/null || true)";; esac; [ "$mode" = website ] || return 1
 url="$(jsonfilter -i "$cfg" -e '@.website_url' 2>/dev/null || true)"; website_url_valid "$url" || return 1
 host="$(website_host_from_url "$url")"; [ -n "$host" ] || return 1
 tmp="/tmp/wiflow-web-dns.$$"; : > "$tmp"
 nslookup "$host" 2>/dev/null | awk '/^Name:[[:space:]]*/{seen=1;next} seen&&/^Address[[:space:]]*[0-9]*:[[:space:]]*/{ip=$0;sub(/^Address[[:space:]]*[0-9]*:[[:space:]]*/,"",ip);print ip} seen&&/^Address:[[:space:]]*/{ip=$0;sub(/^Address:[[:space:]]*/,"",ip);print ip}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u > "$tmp" 2>/dev/null || true
 [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
 cat "$tmp"; rm -f "$tmp"
}

refresh(){
 /usr/sbin/nft list set $CAPTIVE_TABLE web4 >/dev/null 2>&1 || return 1
 /usr/sbin/nft flush set $CAPTIVE_TABLE web4 >/dev/null 2>&1 || return 1
 ips="$(resolve_website_ips 2>/dev/null || true)"
 [ -n "$ips" ] || { state_set website_walled_garden 0; return 0; }
 for ip in $ips; do printf 'add element %s web4 { %s }\n' "$CAPTIVE_TABLE" "$ip" | /usr/sbin/nft -f - >/dev/null 2>&1 || return 1; done
 state_set website_walled_garden 1
 return 0
}

# fw4 side: only the input rule that lets guests reach the portal listener.
fw4_portal_rule(){
 reload=0
 if [ -f "$LEGACY_FILE" ]; then rm -f "$LEGACY_FILE" "$LEGACY_FILE.tmp"; reload=1; fi
 if [ "$(uci -q get firewall.wiflow_guest_portal.dest_port 2>/dev/null || true)" != 2080 ] || [ "$(uci -q get firewall.wiflow_guest_portal.src 2>/dev/null || true)" != wiflow_guest ]; then
  uci -q delete firewall.wiflow_guest_portal >/dev/null 2>&1 || true
  uci set firewall.wiflow_guest_portal='rule'; uci set firewall.wiflow_guest_portal.name='Wiflow-Captive-Portal'; uci set firewall.wiflow_guest_portal.src='wiflow_guest'; uci set firewall.wiflow_guest_portal.proto='tcp'; uci set firewall.wiflow_guest_portal.dest_port='2080'; uci set firewall.wiflow_guest_portal.target='ACCEPT'; uci commit firewall || return 1
  reload=1
 fi
 [ "$reload" = 0 ] || /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
 return 0
}

enable(){
 fw4_portal_rule || return 1
 apply_rules >/dev/null 2>&1 || return 1
 portal_nft_ready || return 1
 refresh || true
 # v1.0.26: speed limit and opening hours live in their own chains.
 guest_policy_apply force >/dev/null 2>&1 || true
 guest_sched_tick >/dev/null 2>&1 || true
 state_set portal_error ''
 return 0
}

ensure(){
 # v1.0.26: safe mode (fail-open) keeps the captive rules off until it ends.
 safe_mode_active && return 0
 # Fast path, called every 15 s: nothing to do while the rules are current.
 if rules_current && portal_nft_ready && [ ! -f "$LEGACY_FILE" ]; then return 0; fi
 enable
}

disable(){
 changed=0; [ -f "$LEGACY_FILE" ] && changed=1; uci -q get firewall.wiflow_guest_portal >/dev/null 2>&1 && changed=1
 /usr/sbin/nft delete table inet wiflow_captive >/dev/null 2>&1 || true
 rm -f "$LEGACY_FILE" "$LEGACY_FILE.tmp"; uci -q delete firewall.wiflow_guest_portal >/dev/null 2>&1 || true; uci commit firewall >/dev/null 2>&1 || true
 [ "$changed" = 1 ] && /etc/init.d/firewall reload >/dev/null 2>&1 || true
}
case "$MODE" in enable) enable;; ensure) ensure;; refresh) refresh;; disable) disable;; *) exit 2;; esac
