#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
SYNC_LOCK=/tmp/wiflow-portal-sync.lock
if ! mkdir "$SYNC_LOCK" 2>/dev/null; then exit 0; fi
cleanup_lock(){ rmdir "$SYNC_LOCK" 2>/dev/null || true; }
trap cleanup_lock EXIT INT TERM
WANTED="${1:-0}"
case "$WANTED" in ''|*[!0-9]*) WANTED=0;; esac
fail(){
 msg="$1"; rev="${REV:-$WANTED}"
 uci set wiflow.core.portal_sync_status='failed'; uci set "wiflow.core.portal_sync_error=$msg"; wlog content "Không nhận được nội dung portal ($msg)" 2>/dev/null || true; uci commit wiflow >/dev/null 2>&1 || true; secure_configs
 [ -n "${STAGE:-}" ] && [ "${KEEP_STAGE:-0}" != 1 ] && rm -rf "$STAGE" 2>/dev/null || true; [ "${KEEP_STAGE:-0}" = 1 ] && rm -f "$STAGE/manifest.list" "$STAGE/portal.json" 2>/dev/null || true
 if [ -n "$(device_token)" ]; then body="{\"revision\":${rev:-0},\"status\":\"failed\",\"error\":\"$(json_escape "$msg")\",\"data_generation\":$WIFLOW_DATA_GENERATION}"; out="/tmp/wiflow-portal-ack.$$"; wiflow_post "$out" "$WIFLOW_PORTAL_API/ack" "$body" >/dev/null 2>&1 || true; rm -f "$out"; fi
 logger -t wiflow-portal-sync "status=failed revision=${rev:-0} error=$msg" 2>/dev/null || true; exit 1
}
RESP="/tmp/wiflow-portal-manifest.$$"; rm -f "$RESP"; umask 077
wiflow_get "$RESP" "$WIFLOW_PORTAL_API/manifest" >/dev/null 2>&1 || fail 'manifest_transport'
ok="$(jsonfilter -i "$RESP" -e '@.ok' 2>/dev/null || true)"; [ "$ok" = true ] || [ "$ok" = 1 ] || fail 'manifest_rejected'
generation="$(jsonfilter -i "$RESP" -e '@.data_generation' 2>/dev/null || true)"; [ "$generation" = "$WIFLOW_DATA_GENERATION" ] || fail 'manifest_generation'
REV="$(jsonfilter -i "$RESP" -e '@.manifest.revision' 2>/dev/null || true)"; case "$REV" in ''|*[!0-9]*) fail 'manifest_revision';; esac
[ "$REV" -gt 0 ] || fail 'manifest_revision'; [ "$WANTED" -eq 0 ] || [ "$REV" -eq "$WANTED" ] || fail 'manifest_revision_changed'
api="$(jsonfilter -i "$RESP" -e '@.manifest.api_version' 2>/dev/null || true)"; [ "$api" = 1 ] || fail 'manifest_api_version'
manifest_generation="$(jsonfilter -i "$RESP" -e '@.manifest.data_generation' 2>/dev/null || true)"; [ "$manifest_generation" = "$WIFLOW_DATA_GENERATION" ] || fail 'manifest_generation'
schema="$(jsonfilter -i "$RESP" -e '@.manifest.snapshot_schema' 2>/dev/null || true)"; [ "$schema" = 2 ] || fail 'manifest_schema'
mode="$(jsonfilter -i "$RESP" -e '@.manifest.mode' 2>/dev/null || true)"; case "$mode" in website|image|video) :;; *) fail 'manifest_mode';; esac
website="$(jsonfilter -i "$RESP" -e '@.manifest.website_url' 2>/dev/null || true)"; if [ -n "$website" ]; then website_url_valid "$website" || fail 'manifest_website_url'; fi
# Renderer source hash is diagnostic only. Runtime compatibility is governed by
# generation + API version + snapshot schema. A stale WP revision must never
# disable an otherwise valid local captive Portal.
renderer="$(jsonfilter -i "$RESP" -e '@.manifest.renderer_hash' 2>/dev/null || true)"
expected="$(cat /usr/share/wiflow/renderer-sha256 2>/dev/null | tr -d '\r\n')"
if [ -n "$renderer" ] && [ -n "$expected" ] && [ "$renderer" != "$expected" ]; then
 logger -t wiflow-portal-sync "renderer_hash_warning expected=$expected manifest=$renderer revision=$REV" 2>/dev/null || true
fi
popup_count="$(jsonfilter -i "$RESP" -e '@.manifest.popup_count' 2>/dev/null || echo 0)"; case "$popup_count" in ''|*[!0-9]*) fail 'popup_count';; esac; [ "$popup_count" -le 5 ] || fail 'popup_count'
current="$(uci -q get wiflow.core.portal_revision 2>/dev/null || echo 0)"; case "$current" in ''|*[!0-9]*) current=0;; esac
if [ "$current" -eq "$REV" ] && [ -f "$PORTAL_ACTIVE/portal.json" ]; then
 active_gen="$(jsonfilter -i "$PORTAL_ACTIVE/portal.json" -e '@.data_generation' 2>/dev/null || true)"
 active_rev="$(jsonfilter -i "$PORTAL_ACTIVE/portal.json" -e '@.revision' 2>/dev/null || true)"
 if [ "$active_gen" = "$WIFLOW_DATA_GENERATION" ] && [ "$active_rev" = "$REV" ]; then
  uci set wiflow.core.portal_sync_status='active'; uci set wiflow.core.portal_sync_error=''; uci commit wiflow >/dev/null 2>&1 || true; rm -f "$RESP"; exit 0
 fi
fi
mkdir -p "$PORTAL_REVISIONS" || fail 'storage_unavailable'
uci set wiflow.core.portal_sync_status='syncing'; uci set wiflow.core.portal_sync_error=''; uci commit wiflow >/dev/null 2>&1 || true
# v1.0.7 storage: one media set may use up to 80% of the real usable space
# (free space + current media). When the new files fit next to the old ones
# the update is an atomic swap as before. When they do not, the router keeps
# the unchanged files, switches the portal to a media-less page (guests can
# still connect), deletes the old files and then downloads the new ones into a
# persistent pending directory that survives failures and reboots.
STORAGE_RESERVE=4194304
PENDING="$PORTAL_RUNTIME/pending-$REV"
for d in "$PORTAL_RUNTIME"/pending-*; do [ -e "$d" ] || continue; [ "$d" = "$PENDING" ] || rm -rf "$d"; done
file_ok(){ [ -f "$1" ] && [ "$(sha256sum "$1" 2>/dev/null | awk '{print $1}')" = "$2" ]; }
WANT="/tmp/wiflow-portal-want.$$"; : > "$WANT"
need=0; j=0
while [ "$j" -lt 24 ]; do
 r_name="$(jsonfilter -i "$RESP" -e "@.manifest.files[$j].name" 2>/dev/null || true)"; [ -n "$r_name" ] || break
 r_hash="$(jsonfilter -i "$RESP" -e "@.manifest.files[$j].sha256" 2>/dev/null || true)"; r_size="$(jsonfilter -i "$RESP" -e "@.manifest.files[$j].size" 2>/dev/null || true)"
 case "$r_size" in ''|*[!0-9]*) r_size=0;; esac
 printf '%s' "$r_name" | grep -Eq '^[A-Za-z0-9._-]{1,120}$' || fail 'media_name'
 printf '%s|%s\n' "$r_name" "$r_hash" >> "$WANT"
 file_ok "$PORTAL_ACTIVE/media/$r_name" "$r_hash" || file_ok "$PENDING/media/$r_name" "$r_hash" || need=$((need + r_size))
 j=$((j+1))
done
set_total=0; j=0
while [ "$j" -lt 24 ]; do t_size="$(jsonfilter -i "$RESP" -e "@.manifest.files[$j].size" 2>/dev/null || true)"; [ -n "$t_size" ] || break; case "$t_size" in *[!0-9]*) t_size=0;; esac; set_total=$((set_total + t_size)); j=$((j+1)); done
budget="$(media_budget_bytes)"; [ "$budget" -gt 0 ] && [ "$set_total" -gt "$budget" ] && { rm -f "$WANT"; fail "media_budget_exceeded:need=$set_total:budget=$budget"; }
free_b="$(storage_free_bytes)"
KEEP_STAGE=0
if [ "$free_b" -ge $((need + STORAGE_RESERVE)) ]; then
 STAGE="$PORTAL_RUNTIME/.staging-$$-$REV"; rm -rf "$STAGE" 2>/dev/null || true; mkdir -p "$STAGE/media" || fail 'staging_create_failed'
 # Files already waiting in a pending directory are reused too.
 if [ -d "$PENDING/media" ]; then for f in "$PENDING"/media/*; do [ -f "$f" ] && ln "$f" "$STAGE/media/" 2>/dev/null; done; fi
else
 # Space freed by deleting the old files that the new set does not reuse.
 freed=0
 if [ -d "$PORTAL_ACTIVE/media" ]; then
  for f in "$PORTAL_ACTIVE"/media/*; do [ -f "$f" ] || continue; n="${f##*/}"; h="$(sha256sum "$f" | awk '{print $1}')"; grep -qx "$n|$h" "$WANT" && continue; links="$(stat -c %h "$f" 2>/dev/null || echo 1)"; [ "$links" -le 1 ] && freed=$((freed + $(wc -c < "$f" | tr -d ' '))); done
 fi
 [ $((free_b + freed)) -ge $((need + STORAGE_RESERVE)) ] || { rm -f "$WANT"; fail "storage_insufficient:need=$need:free=$free_b:freed=$freed"; }
 STAGE="$PENDING"; KEEP_STAGE=1; mkdir -p "$STAGE/media" || fail 'staging_create_failed'
 # Keep unchanged files (hard links), then show the media-less page and free the old set.
 while IFS='|' read -r n h; do [ -f "$STAGE/media/$n" ] && continue; file_ok "$PORTAL_ACTIVE/media/$n" "$h" && ln "$PORTAL_ACTIVE/media/$n" "$STAGE/media/$n" 2>/dev/null; done < "$WANT"
 FB="$PORTAL_REVISIONS/rev-0"; rm -rf "$FB"; mkdir -p "$FB/media" || fail 'fallback_create'
 printf '{"schema":2,"data_generation":4,"revision":0,"fallback":true,"mode":"%s","website_url":"%s","media":{"image_landscape":"","image_portrait":"","video_landscape":"","video_portrait":""},"popups":[]}\n' "$mode" "$(json_escape "$website")" > "$FB/portal.json" || fail 'fallback_write'
 chmod 644 "$FB/portal.json" 2>/dev/null || true
 LINK="$PORTAL_RUNTIME/.active-$$"; rm -f "$LINK"; ln -s "revisions/rev-0" "$LINK" || fail 'active_link'; mv -Tf "$LINK" "$PORTAL_ACTIVE" || fail 'active_swap'
 uci set wiflow.core.portal_revision='0'; uci commit wiflow >/dev/null 2>&1 || true
 for d in "$PORTAL_REVISIONS"/rev-*; do [ -e "$d" ] || continue; [ "$d" = "$FB" ] || rm -rf "$d"; done
 sync
 logger -t wiflow-portal-sync "low-space update revision=$REV need=$need free=$free_b freed=$freed" 2>/dev/null || true
fi
rm -f "$WANT"
MAN="$STAGE/manifest.list"; : > "$MAN"
seen='|'; i=0
while [ "$i" -lt 24 ]; do
 role="$(jsonfilter -i "$RESP" -e "@.manifest.files[$i].role" 2>/dev/null || true)"; [ -n "$role" ] || break
 name="$(jsonfilter -i "$RESP" -e "@.manifest.files[$i].name" 2>/dev/null || true)"; url="$(jsonfilter -i "$RESP" -e "@.manifest.files[$i].download_url" 2>/dev/null || true)"; hash="$(jsonfilter -i "$RESP" -e "@.manifest.files[$i].sha256" 2>/dev/null || true)"; size="$(jsonfilter -i "$RESP" -e "@.manifest.files[$i].size" 2>/dev/null || true)"
 # v1.0.19: shop_data (brand/products/terms JSON), shop_logo and product_1..8 images.
 case "$role" in image_landscape|image_portrait|video_landscape|video_portrait|popup_1|popup_2|popup_3|popup_4|popup_5|shop_data|shop_logo|product_[1-8]) :;; *) fail 'media_role';; esac
 case "$seen" in *"|$role|"*) fail 'media_duplicate';; esac; seen="$seen$role|"
 printf '%s' "$name" | grep -Eq '^[A-Za-z0-9._-]{1,120}$' || fail 'media_name'; case "$url" in "$WIFLOW_PORTAL_API"/media/*) :;; *) fail 'media_url';; esac
 printf '%s' "$hash" | grep -Eq '^[A-Fa-f0-9]{64}$' || fail 'media_hash'; case "$size" in ''|*[!0-9]*) fail 'media_size';; esac; [ "$size" -gt 0 ] && [ "$size" -le 157286400 ] || fail 'media_size'
 out="$STAGE/media/$name"; if file_ok "$out" "$hash"; then :; elif file_ok "$PORTAL_ACTIVE/media/$name" "$hash" && { rm -f "$out"; ln "$PORTAL_ACTIVE/media/$name" "$out" 2>/dev/null; }; then :; else dst="$out"; rm -f "$dst" "$dst.part"; wiflow_get "$dst.part" "$url" >/dev/null 2>&1 || { rm -f "$dst.part"; fail "download_$role"; }; mv -f "$dst.part" "$dst" || fail "download_$role"; out="$dst"; fi; got_size="$(wc -c < "$out" 2>/dev/null | tr -d ' ')"; [ "$got_size" = "$size" ] || fail "size_$role"; got_hash="$(sha256sum "$out" | awk '{print $1}')"; [ "$got_hash" = "$hash" ] || fail "hash_$role"; chmod 644 "$out" 2>/dev/null || true; printf '%s|%s\n' "$role" "$name" >> "$MAN"; i=$((i+1))
done
has(){ grep -q "^$1|" "$MAN" 2>/dev/null; }; path_for(){ awk -F'|' -v r="$1" '$1==r{print "/runtime/active/media/"$2;exit}' "$MAN"; }
# A content snapshot may carry Website + Image + Video assets together. Active mode is synced separately.
n=1; while [ "$n" -le "$popup_count" ]; do has "popup_$n" || fail "popup_${n}_missing"; n=$((n+1)); done
il="$(path_for image_landscape)"; ip="$(path_for image_portrait)"; vl="$(path_for video_landscape)"; vp="$(path_for video_portrait)"; shop="$(path_for shop_data)"
if [ -n "$shop" ]; then jsonfilter -i "$STAGE/media/${shop##*/}" -e '@.v' >/dev/null 2>&1 || fail 'shop_data_invalid'; fi
{
 printf '{"schema":2,"data_generation":4,"revision":%s,"mode":"%s","website_url":"%s","media":{' "$REV" "$mode" "$(json_escape "$website")"; printf '"image_landscape":"%s","image_portrait":"%s","video_landscape":"%s","video_portrait":"%s"},"shop":"%s","popups":[' "$(json_escape "$il")" "$(json_escape "$ip")" "$(json_escape "$vl")" "$(json_escape "$vp")" "$(json_escape "$shop")"; first=1; n=1; while [ "$n" -le "$popup_count" ]; do x="$(path_for "popup_$n")"; [ "$first" = 1 ] || printf ','; first=0; printf '"%s"' "$(json_escape "$x")"; n=$((n+1)); done; printf ']}\n'
} > "$STAGE/portal.json" || fail 'config_write'
jsonfilter -i "$STAGE/portal.json" -e '@.revision' >/dev/null 2>&1 || fail 'config_invalid'
[ "$(jsonfilter -i "$STAGE/portal.json" -e '@.data_generation' 2>/dev/null || true)" = "$WIFLOW_DATA_GENERATION" ] || fail 'config_generation'
[ "$(jsonfilter -i "$STAGE/portal.json" -e '@.mode' 2>/dev/null || true)" = "$mode" ] || fail 'config_mode'
rm -f "$MAN"; chmod 644 "$STAGE/portal.json" 2>/dev/null || true
DEST="$PORTAL_REVISIONS/rev-$REV"; rm -rf "$DEST" 2>/dev/null || true; mv "$STAGE" "$DEST" || fail 'revision_prepare'; STAGE=''; LINK="$PORTAL_RUNTIME/.active-$$"; rm -f "$LINK"; ln -s "revisions/rev-$REV" "$LINK" || fail 'active_link'; if [ -e "$PORTAL_ACTIVE" ] && [ ! -L "$PORTAL_ACTIVE" ]; then rm -rf "$PORTAL_ACTIVE" || fail 'legacy_active'; fi; mv -Tf "$LINK" "$PORTAL_ACTIVE" || fail 'active_swap'
for d in "$PORTAL_REVISIONS"/rev-*; do [ -e "$d" ] || continue; [ "$d" = "$DEST" ] || rm -rf "$d"; done; rm -rf "$PORTAL_RUNTIME"/.staging-* "$PORTAL_RUNTIME"/.active-* "$PORTAL_RUNTIME"/pending-* 2>/dev/null || true
uci set "wiflow.core.portal_revision=$REV"; uci set wiflow.core.portal_sync_status='active'; uci set wiflow.core.portal_sync_error=''; uci commit wiflow >/dev/null 2>&1 || true; secure_configs; /usr/lib/wiflow/portal-firewall refresh >/dev/null 2>&1 || true
wlog content "Nhận nội dung portal bản $REV · $(grep -c . "$MAN" 2>/dev/null || echo 0) file" 2>/dev/null || true
ack="/tmp/wiflow-portal-ack.$$"; body="{\"revision\":$REV,\"status\":\"active\",\"data_generation\":$WIFLOW_DATA_GENERATION}"; wiflow_post "$ack" "$WIFLOW_PORTAL_API/ack" "$body" >/dev/null 2>&1 || true; rm -f "$ack" "$RESP"; logger -t wiflow-portal-sync "status=active revision=$REV mode=$mode" 2>/dev/null || true
exit 0
