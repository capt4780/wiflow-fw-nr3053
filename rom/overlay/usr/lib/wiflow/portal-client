#!/bin/sh
set -u
. /usr/lib/wiflow/common.sh
mode="${1:-}"
value="${2:-}"
expected_client="${3:-}"

log_client_event(){
    event="$1"; sid="${2:-}"; code="${3:-}"
    shash="$(printf '%s' "$sid" | sha256sum | awk '{print substr($1,1,12)}')"
    logger -t wiflow-portal "event=$event session=$shash code=$code" 2>/dev/null || true
}

lock_path=''
acquire_session_lock(){
    sid="$1"; safe="$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9._-')"; [ -n "$safe" ] || return 1
    lock_path="/tmp/wiflow-client-lock-$safe"
    tries=0
    while ! mkdir "$lock_path" 2>/dev/null; do
        owner="$(cat "$lock_path/pid" 2>/dev/null || true)"
        case "$owner" in ''|*[!0-9]*) owner=0;; esac
        if [ "$owner" -eq 0 ] || ! kill -0 "$owner" 2>/dev/null; then rm -rf "$lock_path" 2>/dev/null || true; continue; fi
        tries=$((tries+1)); [ "$tries" -lt 5 ] || return 1; sleep 1
    done
    printf '%s\n' "$$" > "$lock_path/pid" 2>/dev/null || true
    return 0
}
release_session_lock(){ [ -n "$lock_path" ] && rm -rf "$lock_path" 2>/dev/null || true; lock_path=''; }

case "$mode" in
ensure)
    ip="$value"; valid_guest_ip "$ip" || exit 2
    mac="$(guest_mac_for_ip "$ip" 2>/dev/null || true)"; [ -n "$mac" ] || exit 1
    f="$(client_file_for_mac "$mac")" || exit 1; now="$(date +%s)"
    cid=''; sid=''; oldip=''; connected=''; authorized=0; last=''; absent=0
    if [ -f "$f" ]; then
        IFS='|' read -r _mac cid sid oldip connected authorized last absent < "$f" 2>/dev/null || true
        [ -n "${sid:-}" ] || rm -f "$f"
    fi
    if [ ! -f "$f" ]; then
        session_open "$mac" "$ip" >/dev/null || exit 1
        IFS='|' read -r _mac cid sid _oi _cn _au _l _ab < "$f" 2>/dev/null || exit 1
        log_client_event connected "$sid" ok
    else
        if [ "${authorized:-0}" != 0 ]; then
            # v3.4: the firewall set is the truth. Same address and still in the set: nothing to do. A new address
            # (the phone got another lease): move the entry (add the new one before removing the old, no gap). Not in
            # the set any more (silent for too long): the authorization has ended, report it once.
            if portal_nft_pair_authorized "$ip" "$mac"; then :
            elif [ -n "$oldip" ] && [ "$oldip" != "$ip" ] && portal_nft_pair_authorized "$oldip" "$mac" && portal_nft_add "$ip" "$mac"; then
                portal_nft_del "$oldip" "$mac"
            else
                guest_gone "$f" "$mac" "$cid" "$sid" "$ip" "$connected" "$now" "$now"
                authorized=0; absent="$now"
            fi
        fi
        # Back after the access had ended: a new visit with the same session.
        if [ "${absent:-0}" != 0 ] && [ "${authorized:-0}" = 0 ]; then event_enqueue connected "$cid" "$sid" "$now" || true; absent=0; fi
        # Re-read: a confirm may have authorized this guest a moment ago.
        IFS='|' read -r _m _c _s _i _cn authorized _l _ab < "$f" 2>/dev/null || true
        client_session_write "$f" "$mac" "$cid" "$sid" "$ip" "$connected" "${authorized:-0}" "$now" "${absent:-0}" || exit 1
    fi
    printf '%s|%s\n' "$cid" "$sid"
    ;;
authorize-session)
    # v1.0.15: the confirm does one thing - open the Internet for this phone.
    # No network calls, no locks, no read-back: the Internet check already ran
    # in the background (net status) and "add element" is safe to repeat.
    sid="$value"; [ -n "$sid" ] || exit 2
    f="$(client_find_file_by_session "$sid" 2>/dev/null || true)"; [ -n "$f" ] && [ -f "$f" ] || { log_client_event authorize_failed "$sid" session_missing; exit 1; }
    IFS='|' read -r mac cid stored_sid ip connected authorized last absent < "$f" 2>/dev/null || exit 1
    [ "$stored_sid" = "$sid" ] || exit 1
    [ -z "$expected_client" ] || [ "$expected_client" = "$cid" ] || { log_client_event authorize_failed "$sid" client_mismatch; exit 1; }
    valid_guest_ip "$ip" || { log_client_event authorize_failed "$sid" invalid_ip; exit 1; }
    # v1.0.26: outside opening hours (exit 7) / all places taken (exit 6).
    sched_closed && { log_client_event authorize_failed "$sid" closed; exit 7; }
    # v3.4: only the firewall set says who is authorized; a session flag the set no longer backs counts as not authorized.
    case "${authorized:-0}" in ''|0) :;; *) portal_nft_pair_authorized "$ip" "$mac" || authorized=0;; esac
    case "${authorized:-0}" in ''|0) guest_full && { log_client_event authorize_failed "$sid" full; exit 6; };; esac
    # v3.1: a new guest is only let in when the way out works (Internet, DNS, private DNS); nothing is stored otherwise.
    case "${authorized:-0}" in ''|0) grant_verify || { log_client_event authorize_failed "$sid" verify; exit 8; };; esac
    printf 'add element %s authed { %s . %s timeout %ss }\n' "$CAPTIVE_TABLE" "$ip" "$mac" "$(guest_idle_secs)" | /usr/sbin/nft -f - >/dev/null 2>&1 || { log_client_event authorize_failed "$sid" policy_apply; exit 5; }
    now="$(date +%s)"; newly=0
    case "${authorized:-0}" in ''|0) authorized="$now"; newly=1;; esac
    client_session_write "$f" "$mac" "$cid" "$sid" "$ip" "$connected" "$authorized" "$now" 0 || true
    # Bookkeeping after the grant, detached so the reply is not held back.
    ( [ "$newly" = 0 ] || event_enqueue authorized "$cid" "$sid" "$now"; : > "$HEARTBEAT_KICK"; log_client_event authorized "$sid" granted ) </dev/null >/dev/null 2>&1 &
    exit 0
    ;;
revoke-session)
    sid="$value"; [ -n "$sid" ] || exit 2
    acquire_session_lock "$sid" || exit 3
    trap 'release_session_lock' EXIT HUP INT TERM
    f="$(client_find_file_by_session "$sid" 2>/dev/null || true)"; [ -n "$f" ] && [ -f "$f" ] || exit 0
    IFS='|' read -r mac cid stored_sid ip connected authorized last absent < "$f" 2>/dev/null || exit 0
    portal_nft_del "$ip" "$mac"
    now="$(date +%s)"; client_session_write "$f" "$mac" "$cid" "$sid" "$ip" "$connected" 0 "$now" "${absent:-0}" || true
    : > "$HEARTBEAT_KICK" 2>/dev/null || true
    log_client_event revoked "$sid" ok
    ;;
is-authorized)
    sid="$value"; f="$(client_find_file_by_session "$sid" 2>/dev/null || true)"; [ -n "$f" ] && [ -f "$f" ] || exit 1
    IFS='|' read -r mac _cid _sid ip _connected authorized _last _absent < "$f" 2>/dev/null || exit 1
    [ "${authorized:-0}" != 0 ] || exit 1
    portal_nft_pair_authorized "$ip" "$mac"
    ;;
*) exit 2;;
esac
