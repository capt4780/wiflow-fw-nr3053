#!/bin/sh
# Link between the Wiflow agent (ucode, talks to WordPress) and the guest
# portal engine (shell). The agent calls it; nothing here talks to WordPress
# except portal-sync (content download) and portal-client (guest sessions).
#   portal-hb report            one JSON object: events, stats, portal state
#   portal-hb ack <events>      WordPress accepted the report
#   portal-hb content <rev>     fetch the content revision WordPress wants
#   portal-hb timeok            the router clock was confirmed
#   portal-hb unpaired          the router left its account: portal off, content and guests cleared
#   portal-hb guest-settings <file.json>   apply a guest_settings command
set -u
. /usr/lib/wiflow/common.sh

build_events_json(){
 batch="$1"; first=1; printf '['
 while IFS='|' read -r eid cid sid event occurred; do
  [ -n "$eid" ] || continue
  [ "$first" = 1 ] || printf ','; first=0
  printf '{"event_id":"%s","client_id":"%s","session_id":"%s","event_type":"%s","occurred_at":%s}' \
   "$(json_escape "$eid")" "$(json_escape "$cid")" "$(json_escape "$sid")" "$(json_escape "$event")" "${occurred:-0}"
 done < "$batch"
 printf ']'
}

case "${1:-}" in
report)
 batch="/tmp/wiflow-event-batch.$$"
 count="$(event_prepare_batch "$batch" 30 2>/dev/null || echo 0)"; case "$count" in ''|*[!0-9]*) count=0;; esac
 events="$(build_events_json "$batch")"; rm -f "$batch"
 rev="$(cfg_num portal_revision 0)"
 sync="$(uci -q get wiflow.core.portal_sync_status 2>/dev/null || echo idle)"; err="$(uci -q get wiflow.core.portal_sync_error 2>/dev/null || true)"
 ad="$(adstats_take 2>/dev/null || echo '[]')"; [ -n "$ad" ] || ad='[]'
 printf '{"event_count":%s,"events":%s,"ad_stats":%s,"stats":%s,"active_portal_revision":%s,"portal_sync_status":"%s","portal_sync_error":"%s","storage_total_bytes":%s,"media_budget_bytes":%s,"health":%s}\n' \
  "$count" "$events" "$ad" "$(stats_json)" "$rev" "$(json_escape "$sync")" "$(json_escape "$err")" "$(storage_total_bytes)" "$(media_budget_bytes)" "$(portal_health_json)"
 ;;
ack)
 event_ack_batch "${2:-0}" >/dev/null 2>&1 || true
 adstats_ack >/dev/null 2>&1 || true
 ;;
content)
 desired="${2:-0}"; case "$desired" in ''|*[!0-9]*) exit 0;; esac
 [ "$desired" -gt 0 ] || exit 0
 current="$(cfg_num portal_revision 0)"
 if [ "$desired" -ne "$current" ] || [ ! -f "$PORTAL_ACTIVE/portal.json" ]; then
  /usr/lib/wiflow/portal-sync "$desired" >/dev/null 2>&1 || exit 1
 fi
 ;;
timeok) state_set wp_time_ok 1 ;;
unpaired)
 /usr/lib/wiflow/portal-firewall disable >/dev/null 2>&1 || true
 uci set wiflow.core.portal_enabled='0'
 portal_storage_reset
 uci commit wiflow >/dev/null 2>&1 || true
 rm -f "$EVENT_QUEUE" "$HEARTBEAT_KICK" "$ADSTATS" "$ADSTATS.sending" "$SESSION_SNAP" 2>/dev/null || true
 rm -rf "$CLIENT_SESSIONS"/* 2>/dev/null || true
 ;;
guest-settings)
 f="${2:-}"; [ -f "$f" ] || exit 2
 g(){ jsonfilter -i "$f" -e "@.$1" 2>/dev/null || true; }
 se="$(g sched_enabled)"; case "$se" in true|1) se=1;; false|0) se=0;; *) se='';; esac
 guest_settings_set "$(g down_kbps)" "$(g up_kbps)" "$(g session_min)" "$(g max)" "$se" "$(g sched_from)" "$(g sched_to)" "$(g sched_days)" "$(g sched_week)"
 ;;
*) exit 2 ;;
esac
