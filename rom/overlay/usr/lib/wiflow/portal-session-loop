#!/bin/sh
# Guest portal background loop (one instance, started by the wiflow service).
#   every 5 s    the router's Internet status for the portal (net_maintain)
#   every 30 s   opening hours, safe mode end, portal rules kept up (self-repair)
#   every minute guest sessions against the firewall set (sessions_sweep), guest counts, watchdog
# v3.4: nothing here looks at individual guests between those passes. The firewall renews the idle timer of every
# authorized guest by itself and drops the ones that stay silent (see portal-firewall).
set -u
. /usr/lib/wiflow/common.sh
tick=0

while true; do
    sleep 5
    # Keep the router Internet status fresh for the portal (owner of the periodic check). Link loss is seen at once
    # without network traffic; while offline the check repeats every 5 s so guests get Internet back fast.
    net_maintain
    net_down_tick
    tick=$((tick+1))
    if [ $((tick % 6)) = 0 ]; then
        guest_sched_tick >/dev/null 2>&1 || true
        # Safe mode ends by itself after 10 minutes: the captive portal comes back.
        safe_mode_tick >/dev/null 2>&1 || true
        portal_activate >/dev/null 2>&1 || true
    fi
    if [ $((tick % 12)) = 0 ]; then
        sessions_sweep >/dev/null 2>&1 || true
        stats_sample >/dev/null 2>&1 || true
        watchdog_tick >/dev/null 2>&1 || true
        tick=0
    fi
done
