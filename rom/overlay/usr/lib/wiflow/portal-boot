#!/bin/sh
# Guest portal start-up (called by the wiflow service in the background):
# waits for the guest network, restores guest sessions and turns the captive
# rules on when a content snapshot is already on the router.
set -u
. /usr/lib/wiflow/common.sh
i=0
while [ "$i" -lt 60 ]; do
    ip addr show dev br-wiflow 2>/dev/null | grep -q '10\.10\.10\.1/' && break
    sleep 1; i=$((i+1))
done
tcp_listening 010A0A0A 0820 || /etc/init.d/uhttpd restart >/dev/null 2>&1 || true
uci -q get wiflow.core >/dev/null 2>&1 || { uci set wiflow.core=core; uci commit wiflow; }
portal_storage_gc
restored="$(session_restore 2>/dev/null || echo 0)"; wlog system "Khôi phục ${restored:-0} phiên khách"
portal_activate || wlog portal 'Không bật được tường lửa cổng chào'
