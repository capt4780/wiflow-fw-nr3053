#!/usr/bin/ucode
// Wiflow agent (procd service "wiflow"): every 20 s
//  - reads the router's Internet status (one checker keeps it, see W.net_status) and runs the self-recovery;
//  - talks to WordPress: heartbeat, commands, command results, unpair.
// It does not change the WiFi or the network: that is done in LuCI.
// Everything it keeps is in RAM (/tmp/wiflow); nothing is written to flash
// except the pairing / settings a command changes.
'use strict';

import { readfile, writefile, unlink, access, stat } from 'fs';
import * as W from 'wiflow.setup';
import * as S from 'wiflow.stats';

// 20 s on the router; the test bench runs the same loop faster.
const TICK = +(getenv('WIFLOW_TICK') ?? 20) || 20;

let hb_delay = TICK;
let next_hb = 0;

/* -------------------------------------------------------------- helpers */

// Which uplink carries the traffic: wifi (a client interface apcli*), lan or none.
function uplink_kind() {
	for (let l in split(readfile('/proc/net/route') ?? '', '\n')) {
		const f = split(trim(replace(l, /\s+/g, ' ')), ' ');
		if (length(f) >= 8 && f[1] == '00000000' && f[7] == '00000000')
			return match(f[0], /^(apcli|apclii|apclix|wlan[0-9]+-sta|phy[0-9]+-sta)/) ? 'wifi' : 'lan';
	}
	return 'none';
}

function wan_carrier() {
	const dev = W.uci_get('network', 'wan', 'device') ?? 'wan';
	return trim(readfile(`/sys/class/net/${dev}/carrier`) ?? '0') == '1';
}

function internet_tick() {
	const n = W.net_status(TICK);
	const online = n.online;
	const prev = W.st_get('online', false);
	if (online && !prev) W.st_set('online_since', W.uptime());
	W.st_set('online', online);
	W.st_set('latency', n.latency);
	return online;
}

/* ------------------------------------------------- self-recovery of the uplink */
// The Internet is down although a link exists (WAN cable with carrier, or a
// WiFi uplink is configured). Escalate slowly, each step once per outage:
//   after 3 min  ifup of the WAN interface and of the WiFi uplink (a fresh DHCP attempt)
//   (a saved WiFi source that is not joined gets its WiFi restarted much earlier, see wifi_source_tick)
//   after 15 min wifi reload (radios and the WiFi uplink restart)
//   after 30 min reboot, at most 3 in a row; the count resets after 10 min online
// Nothing is written to flash except right before a recovery reboot (the
// reboot reason and the counter) and when the counter is cleared again.
// v3.5: the WAN and WiFi steps (3 and 15 minutes) are skipped when the source router (the default gateway) still
// answers: the link is fine, the outage is outside, and restarting here would only drop the guests. The 30 minute
// restart stays as the last safety net (a fault inside this router is not seen by the gateway test). All the clocks
// start again while something else is busy with the network (see hold_reason).
// The test bench runs the same steps WIFLOW_REC_SCALE times faster.
const RS = +(getenv('WIFLOW_REC_SCALE') ?? 1) || 1;
const REC_T1 = 180 / RS, REC_T2 = 900 / RS, REC_T3 = 1800 / RS, REC_MAX = 3, REC_OK = 600 / RS, REC_BOOT = 60 / RS;
const EDIT_HOLD = 180 / RS, SYNC_HOLD = 1200 / RS, DISRUPT_HOLD = 120 / RS;
let off_since = null, on_since = null, rec_stage = 0, held = null;

function sta_configured() {
	for (let l in split(W.sh('uci -q show wireless'), '\n'))
		if (match(l, /\.mode='sta'$/))
			return true;
	return false;
}

function link_expected() {
	return wan_carrier() || sta_configured();
}

// Is a file or directory changed within the last `secs` seconds (a clock that moved back counts as not recent)?
function recent(path, secs) {
	const m = stat(path)?.mtime;
	const d = time() - (m ?? 0);
	return m != null && d >= 0 && d < secs;
}

// Why the recovery must wait now (null: it may act). Restarting the WiFi or the WAN while someone sets the link up,
// while the line is busy with a content download or right after another restart only makes things worse.
function hold_reason() {
	if (W.job_busy())
		return 'a Wiflow change is in progress';
	for (let p in [ '/etc/config/network', '/etc/config/wireless', '/tmp/.uci/network', '/tmp/.uci/wireless' ])
		if (recent(p, EDIT_HOLD))
			return 'the network or WiFi settings were just changed';
	if (recent('/tmp/wiflow-portal-sync.lock', SYNC_HOLD))
		return 'new content is downloading';
	if (W.disrupt_recent(DISRUPT_HOLD))
		return 'the network was just restarted';
	return null;
}

// Has the gateway's address been resolved (a complete entry in the ARP table)?
function arp_ok(ip) {
	for (let l in split(readfile('/proc/net/arp') ?? '', '\n')) {
		const f = split(trim(replace(l, /\s+/g, ' ')), ' ');
		if (length(f) >= 4 && f[0] == ip)
			return (hex(f[2]) & 2) != 0 && f[3] != '00:00:00:00:00:00';
	}
	return false;
}

// Does the source router (the default gateway) answer? Then the link is fine and the outage is outside.
// A ping is the test. This image's BusyBox is trimmed and may have no ping (the shell then says 127): a connection to
// the gateway then does the same job. One that is there answers it or refuses it (and its address is resolved);
// one that is not there does not answer at all. Any doubt counts as "does not answer", which leaves the recovery
// exactly as it was before 3.5.
function gw_alive() {
	for (let l in split(readfile('/proc/net/route') ?? '', '\n')) {
		const f = split(trim(replace(l, /\s+/g, ' ')), ' ');
		if (length(f) >= 8 && f[1] == '00000000' && f[7] == '00000000') {
			const g = hex(f[2]);
			if (!g)
				return false;
			const ip = `${g & 255}.${(g >> 8) & 255}.${(g >> 16) & 255}.${(g >> 24) & 255}`;
			const r = W.run(`ping -c 1 -W 2 ${ip}`);
			if (r.code != 127)
				return r.code == 0;
			const c = W.run(`curl -s -m 3 --connect-timeout 2 -o /dev/null http://${ip}/`).code;
			return c == 0 || c == 52 || c == 56 || (c == 7 && arp_ok(ip));
		}
	}
	return false;
}

// Whenever the Internet is lost (typically after a power cut: the router starts before the source does, and the
// WiFi client of this driver does not scan again by itself) the link is retried every 2 minutes, the first time
// after 1 minute without Internet, until the Internet is back. The 3, 15 and 30 minute steps below stay as the safety net.
// v3.3: the retries slow down (2, 5, 10, then every 15 minutes): every wifi reload also restarts the guest WiFi and
// drops the guests, so a source that stays away must not make the guest WiFi flap every 2 minutes.
const WS_FIRST = 60 / RS, WS_STEPS = [ 120 / RS, 300 / RS, 600 / RS, 900 / RS ];
let ws_next = null, ws_n = 0;

function wifi_source_tick(now, off) {
	if (ws_next == null)
		ws_next = now - off + WS_FIRST;
	if (now < ws_next)
		return;
	ws_next = now + WS_STEPS[ws_n < 3 ? ws_n : 3];
	ws_n++;
	if (!wan_carrier() && sta_configured() && uplink_kind() == 'none') {
		W.wlog('system', 'The source WiFi is not joined: restarting the WiFi');
		W.run('(wifi reload) </dev/null >/dev/null 2>&1 &');
	} else if (gw_alive()) {
		W.wlog('system', 'No Internet, but the source router answers: the outage is outside, nothing is restarted');
	} else {
		W.wlog('system', 'No Internet: renewing the connection');
		W.run('ifup wan >/dev/null 2>&1 &');
		if (sta_configured())
			W.run('ifup wwan >/dev/null 2>&1 &');
	}
}

function boot_reason(reason) {
	W.core_set({ boot_reason: reason });
}

function recovery_tick(online) {
	const now = W.uptime();
	if (online) {
		off_since = null;
		rec_stage = 0;
		ws_next = null;
		ws_n = 0;
		if (on_since == null) on_since = now;
		if (now - on_since >= REC_OK && W.num(W.core('recovery_reboots', '0'), 0) > 0)
			W.core_set({ recovery_reboots: null });
		W.st_set('recovery', { stage: 0, offline_s: 0 });
		return;
	}
	on_since = null;
	if (off_since == null) off_since = now;
	// Only act when the first Internet check after boot has had time and a link exists.
	if (W.uptime() < REC_BOOT || !link_expected()) {
		W.st_set('recovery', { stage: rec_stage, offline_s: now - off_since });
		return;
	}
	const why = hold_reason();
	if (why) {
		if (why != held)
			W.wlog('system', `Self-recovery waits: ${why}`);
		held = why;
		off_since = now;
		ws_next = null;
		ws_n = 0;
		rec_stage = 0;
		W.st_set('recovery', { stage: 0, offline_s: 0 });
		return;
	}
	held = null;
	const off = now - off_since;
	W.st_set('recovery', { stage: rec_stage, offline_s: off });
	wifi_source_tick(now, off);
	if (rec_stage < 1 && off >= REC_T1) {
		rec_stage = 1;
		if (gw_alive()) {
			W.wlog('system', 'No Internet for 3 minutes, but the source router answers: the outage is outside, nothing is restarted');
		} else {
			W.wlog('system', 'No Internet for 3 minutes: renewing the WAN connection');
			W.run('ifup wan >/dev/null 2>&1 &');
			if (sta_configured())
				W.run('ifup wwan >/dev/null 2>&1 &');
		}
	} else if (rec_stage < 2 && off >= REC_T2) {
		rec_stage = 2;
		if (gw_alive()) {
			W.wlog('system', 'No Internet for 15 minutes, but the source router answers: the WiFi is left alone');
		} else {
			W.wlog('system', 'No Internet for 15 minutes: restarting the WiFi');
			W.run('(wifi reload) </dev/null >/dev/null 2>&1 &');
		}
	} else if (rec_stage < 3 && off >= REC_T3) {
		rec_stage = 3;
		const n = W.num(W.core('recovery_reboots', '0'), 0);
		if (n >= REC_MAX) {
			W.wlog('system', 'No Internet for 30 minutes: the automatic restarts are used up, waiting');
			return;
		}
		W.wlog('system', 'No Internet for 30 minutes: restarting the router');
		W.core_set({ recovery_reboots: n + 1, boot_reason: 'auto_recovery' });
		W.run('sync');
		W.run('(sleep 3; reboot) </dev/null >/dev/null 2>&1 &');
	}
	W.st_set('recovery', { stage: rec_stage, offline_s: off });
}

/* ------------------------------------------------------------ WordPress */

function mem_kb(k) {
	const m = match(readfile('/proc/meminfo') ?? '', regexp(`${k}:\\s+([0-9]+)`));
	return m ? +m[1] : 0;
}

function health(online, extra) {
	const load = split(readfile('/proc/loadavg') ?? '0', ' ')[0];
	const up = online ? uplink_kind() : 'none';
	const h = {
		uptime: W.uptime(), mem_total_kb: mem_kb('MemTotal'), mem_free_kb: mem_kb('MemAvailable'),
		clients_now: W.st_get('stats', {}).clients?.now ?? 0, clients_connected: W.st_get('stats', {}).clients?.now ?? 0,
		load: +load, wan_link: wan_carrier(), wwan_link: up == 'wifi',
		uplink_active: up, uplink_switches: 0, watchdog_restarts: 0,
		time_ok: W.st_get('time_ok', false),
		boot_reason: W.st_get('boot_reason', 'power_or_manual'), recovery_stage: W.st_get('recovery', {}).stage ?? 0,
		recovery_reboots: W.num(W.core('recovery_reboots', '0'), 0)
	};
	// Guest portal numbers (authorized guests, safe mode, opening hours, portal state).
	for (let k, v in extra ?? {})
		h[k] = v;
	return h;
}

// Guest portal engine (shell): events, statistics and state to report.
function portal_report() {
	const r = W.run('/usr/lib/wiflow/portal-hb report');
	const o = r.code == 0 ? json(trim(r.out)) : null;
	return type(o) == 'object' ? o : {};
}

// Fetch the content revision WordPress wants, in the background. Nothing runs while the router already has it or a
// download is still going. After a failure the pause grows (1, 2, 5, 10, then every 30 minutes): a download that
// keeps failing must not keep the line busy. A new revision starts afresh. (A partly downloaded file is kept by
// portal-sync and continued, so a retry costs little.)
const CT_STEPS = map([ 60, 120, 300, 600, 1800 ], x => x / RS);
let ct_rev = null, ct_fails = 0, ct_next = 0, ct_t0 = null;

function portal_content(desired, active, status) {
	if (!match(`${desired}`, /^[0-9]+$/) || +desired <= 0)
		return;
	if (+desired == +(active ?? -1)) {
		ct_fails = 0;
		ct_next = 0;
		ct_t0 = null;
		return;
	}
	if (ct_rev != +desired) {
		ct_rev = +desired;
		ct_fails = 0;
		ct_next = 0;
		ct_t0 = null;
	}
	if (access('/tmp/wiflow-portal-sync.lock'))
		return;
	const now = W.uptime();
	if (ct_t0 != null) {
		// the last attempt has ended: a failure lengthens the pause (counted from now, so a long transfer that stalled
		// does not start again at once)
		if (status == 'failed') {
			ct_fails++;
			ct_next = now + CT_STEPS[min(ct_fails, length(CT_STEPS)) - 1];
		}
		ct_t0 = null;
	}
	if (now < ct_next)
		return;
	ct_t0 = now;
	ct_next = now + CT_STEPS[0];
	W.run(`(/usr/lib/wiflow/portal-hb content ${+desired}) </dev/null >/dev/null 2>&1 &`);
}

function command_result() {
	const id = W.core('last_command_id');
	if (!id)
		return null;
	return {
		id: id, action: W.core('last_command_action', ''),
		status: W.core('last_command_status', 'failed'), message: W.core('last_command_message', '')
	};
}

function result(id, action, status, message) {
	W.core_set({ last_command_id: id, last_command_action: action, last_command_status: status, last_command_message: message });
}

function df_total() {
	const o = W.sh('df -k /overlay');
	const l = split(trim(o), '\n');
	const f = split(trim(replace(l[length(l) - 1] ?? '', /\s+/g, ' ')), ' ');
	return W.num(f[1], 0) * 1024;
}

function diag_send(id, online) {
	const text = W.diag_text();
	writefile(`${W.RUN}/diag.txt`, text);
	const r = W.http('POST', '/devices/diag', { command_id: id, health: health(online), text: substr(text, 0, 16000), log: W.wlog_list(150) }, W.auth(), 20);
	return !!r.body?.ok;
}

function run_command(cmd, online) {
	const id = cmd?.id, action = cmd?.action;
	if (type(id) != 'string' || !match(id, /^[A-Za-z0-9._:-]{1,80}$/) || type(action) != 'string')
		return;
	if (id == W.core('last_command_id'))
		return;

	W.wlog('system', `Command from the app: ${action}`);
	switch (action) {
	case 'reboot':
		result(id, action, 'rebooting', 'The router is restarting');
		boot_reason('wp_command');
		W.run('sync');
		W.run('(sleep 5; reboot) </dev/null >/dev/null 2>&1 &');
		break;
	case 'diag': {
		result(id, action, 'running', 'Sending the diagnostics report');
		const ok = diag_send(id, online);
		result(id, action, ok ? 'success' : 'failed', ok ? 'The diagnostics report was sent' : 'The diagnostics report could not be sent');
		break;
	}
	case 'guest_settings': {
		// Session time, maximum guests and opening hours (set in WordPress).
		writefile(`${W.RUN}/guest-settings.json`, sprintf('%J', cmd.payload ?? {}));
		const ok = W.run(`/usr/lib/wiflow/portal-hb guest-settings ${W.RUN}/guest-settings.json`).code == 0;
		result(id, action, ok ? 'success' : 'failed', ok ? 'Guest WiFi settings applied' : 'Guest WiFi settings are not valid');
		W.kick_agent();
		break;
	}
	case 'guest_ssid': {
		// New name of the guest WiFi (set in WordPress); the radios restart for a few seconds.
		writefile(`${W.RUN}/guest-ssid.json`, sprintf('%J', cmd.payload ?? {}));
		const ok = W.run(`/usr/lib/wiflow/portal-hb guest-ssid ${W.RUN}/guest-ssid.json`).code == 0;
		if (ok) {
			W.disrupt_mark();
			W.run('(sleep 2; reload_config) </dev/null >/dev/null 2>&1 &');
		}
		result(id, action, ok ? 'success' : 'failed', ok ? 'Guest WiFi name changed' : 'The guest WiFi name is not valid');
		W.kick_agent();
		break;
	}
	default:
		result(id, action, 'failed', 'Not supported by this router. WiFi and network are set in LuCI.');
	}
}

function heartbeat(online) {
	const a = W.auth();
	if (!a || W.core('paired', '0') != '1') {
		W.st_set('wp_online', false);
		return TICK;
	}
	if (!online) {
		W.st_set('wp_online', false);
		W.st_set('wp_error', 'no_internet');
		return TICK;
	}

	const names = W.wifi_names();
	const p = portal_report();
	const r = W.http('POST', '/devices/heartbeat', {
		agent_version: W.VERSION, data_generation: +W.GEN, internet: online,
		connection: names.source ? 'auto' : 'lan',
		wifi_ssid: names.source, guest_ssid: names.ap,
		active_portal_revision: p.active_portal_revision ?? 0,
		storage_total_bytes: p.storage_total_bytes ?? df_total(), media_budget_bytes: p.media_budget_bytes ?? 0,
		portal_sync_status: p.portal_sync_status ?? 'idle', portal_sync_error: p.portal_sync_error ?? '',
		events: p.events ?? [], guests: p.guests ?? [], command_result: command_result(), health: health(online, p.health),
		stats: p.stats ?? [], ad_stats: p.ad_stats ?? [], log: W.wlog_list(15)
	}, a, 15);

	const b = r.body;
	if (b?.ok) {
		if (`${b.data_generation}` != W.GEN) {
			W.st_set('wp_online', false);
			W.st_set('wp_error', 'generation_mismatch');
			return 15 * TICK;
		}
		W.st_set('wp_online', true);
		W.st_set('wp_error', null);
		W.st_set('wp_last_ok', W.now());
		W.st_set('unpair_n', null);
		if (type(b.account_public_id) == 'string' && match(b.account_public_id, /^WIFUID[0-9]{6}$/)
		    && b.account_public_id != W.core('account_public_id'))
			W.core_set({ account_public_id: b.account_public_id });
		if (type(b.location_name) == 'string' && b.location_name != W.core('location_name'))
			W.core_set({ location_name: W.clip_text(b.location_name, 200) });
		if (type(b.device_name) == 'string' && b.device_name != W.core('device_name'))
			W.core_set({ device_name: W.clip_text(b.device_name, 60) });
		const st = +b.server_time;
		if (st > 1600000000) {
			if (W.now() - st <= 300 && st - W.now() <= 300) W.st_set('time_ok', true);
			else if (W.run(`date -s @${st}`).code == 0) {
				W.st_set('time_ok', true);
				W.wlog('system', 'The router clock was set from the Wiflow server');
			}
		}
		// WordPress took the events and counters: drop them from the queue.
		W.run(`/usr/lib/wiflow/portal-hb ack ${W.num(p.event_count, 0)} ${W.num(p.guest_count, 0)}`);
		if (type(b.plan_active) == 'bool') {
			const pa = b.plan_active ? '1' : '0', pe = `${+b.plan_expires || 0}`;
			if (W.core('plan_active', '1') != pa || W.core('plan_expires', '0') != pe) {
				W.core_set({ plan_active: pa, plan_expires: pe });
				W.run('/usr/lib/wiflow/portal-hb plan');
				W.wlog('system', b.plan_active ? 'The usage plan is active' : 'The usage plan has ended: the guest page is off');
			}
		}
		portal_content(b.desired_portal_revision, p.active_portal_revision, p.portal_sync_status);
		if (b.command)
			run_command(b.command, online);
		return TICK;
	}

	W.st_set('wp_online', false);
	const code = b?.code;
	W.st_set('wp_error', code ?? 'transport');
	if (code == 'DEVICE_UNPAIRED') {
		// Confirmed three times over at least two minutes before the router
		// forgets its account.
		let u = W.st_get('unpair_n') ?? { n: 0, first: W.uptime() };
		u.n++;
		W.st_set('unpair_n', u);
		if (u.n >= 3 && W.uptime() - u.first >= 6 * TICK) {
			W.clear_pairing();
			W.wlog('system', 'The router was removed from the Wiflow account in the app');
		}
		return 3 * TICK;
	}
	W.st_set('unpair_n', null);
	if (code == 'DEVICE_AUTH_INVALID' || code == 'DEVICE_AUTH_MISSING')
		return min(30 * TICK, max(3 * TICK, hb_delay * 2));
	if (code == 'DEVICE_GENERATION_MISMATCH')
		return 15 * TICK;
	return min(9 * TICK, hb_delay * 2);
}

/* -------------------------------------------------------------- main */

// libubox installs its own SIGTERM/SIGINT handlers on the first ubus
// connection; this loop does not run uloop, so procd's stop must kill it.
W.bus();
signal('SIGTERM', 'default');
signal('SIGINT', 'default');

// Why did the router start? A reason left by our own reboot, else power or a
// manual restart. Read once per boot; the stored reason is cleared again.
{
	const br = W.core('boot_reason');
	if (br) {
		W.st_set('boot_reason', br);
		W.core_set({ boot_reason: null });
	} else if (W.st_get('boot_reason') == null) {
		W.st_set('boot_reason', 'power_or_manual');
	}
}
W.wlog('system', `Wiflow ${W.VERSION} started`);
while (true) {
	const t0 = W.uptime();
	let online = false;
	try { online = internet_tick(); } catch (e) { W.wlog('system', `internet: ${e}`); }

	try { recovery_tick(online); } catch (e) { W.wlog('system', `recovery: ${e}`); }

	try { S.sample(W.st_get('latency', -1)); } catch (e) { W.wlog('system', `stats: ${e}`); }

	const kicked = access(`${W.RUN}/kick`);
	if (kicked) unlink(`${W.RUN}/kick`);
	if (kicked || t0 >= next_hb) {
		try { hb_delay = heartbeat(online); } catch (e) { hb_delay = 60; W.wlog('system', `heartbeat: ${e}`); }
		next_hb = W.uptime() + hb_delay;
	}

	// Sleep until the next tick; a kick file (pairing, command result) wakes
	// the loop early.
	for (let i = 0; i < TICK; i++) {
		if (access(`${W.RUN}/kick`))
			break;
		sleep(1000);
	}
}
