#!/bin/sh /etc/rc.common
# Wiflow Setup: the agent that links the router to a Wiflow account.

START=96
STOP=10
USE_PROCD=1

start_service() {
	/usr/libexec/wiflow/provision boot >/dev/null 2>&1

	procd_open_instance agent
	procd_set_param command /usr/libexec/wiflow/agent
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	# Guest portal: content/mode sync with WordPress, guest sessions.
	procd_open_instance portal_mode
	procd_set_param command /usr/lib/wiflow/portal-mode-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance

	procd_open_instance portal_sessions
	procd_set_param command /usr/lib/wiflow/portal-session-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance

	( /usr/lib/wiflow/portal-boot ) </dev/null >/dev/null 2>&1 &
}

# Clean stop / reboot: keep the authorized guests for the next start.
stop_service() {
	( . /usr/lib/wiflow/common.sh; session_snapshot ) >/dev/null 2>&1 || true
}
