#!/bin/sh /etc/rc.common
# Wiflow Setup: the agent that links the router to a Wiflow account.

START=96
STOP=10
USE_PROCD=1

start_service() {
	/usr/libexec/wiflow/provision boot >/dev/null 2>&1

	procd_open_instance agent
	procd_set_param command /usr/libexec/wiflow/agent
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
